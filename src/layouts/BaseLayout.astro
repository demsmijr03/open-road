---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/figtree';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** Floats the header over a full-bleed hero. Home page only. */
  heroOverlay?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  noindex = false,
  heroOverlay = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

/* Structured data. Legal name and EIN are still placeholders in content.md, so
   they are deliberately omitted rather than guessed. A wrong EIN in
   machine-readable markup is worse than an absent one. */
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'The Open Road Foundation',
  url: Astro.site?.toString(),
  description:
    'We fund West Chester Area School District students to attend the school that fits them best.',
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'West Chester Area School District, Pennsylvania',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Icons are generated from public/favicon.svg by scripts/make-assets.mjs,
         so they cannot drift from the mark. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Open Road Foundation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Cross-page transitions. Astro's own router, a few KB, rather than a
         framework. Header and footer persist across swaps so they do not
         flash. -->
    <ClientRouter />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={heroOverlay} transition:persist />
    <main id="main">
      <slot />
    </main>
    <Footer transition:persist />

    <!-- Scroll reveals. Listens on astro:page-load, not DOMContentLoaded: with
         the router active the latter fires once and every page navigated to
         afterwards would arrive with its content still invisible. -->
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
