---
import { Image } from 'astro:assets';
import givingPhoto from '../assets/community-giving.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Placeholder from '../components/Placeholder.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import MilestoneRail from '../components/MilestoneRail.astro';
import InterestForm from '../components/InterestForm.astro';
import Icon from '../components/Icon.astro';

const ways = [
  { icon: 'give',    name: 'Give',                     note: 'One gift, once, straight to the award.', href: '#give' },
  { icon: 'partner', name: 'Partner with us',          note: 'For businesses and community organizations.', href: '#partner' },
  { icon: 'ask',     name: "Tell us you're interested", note: 'Student, parent, counselor, mentor, donor.', href: '#interest' },
  { icon: 'tell',    name: 'Spread the word',          note: 'Send this to someone in West Chester.', href: '#newsletter' },
] as const;

const tiers = [
  {
    name: 'Founding Supporter',
    amount: 'Any amount up to $499',
    gets: 'Your name listed on this site as part of the founding year. That list closes the day the first student is funded.',
  },
  {
    name: 'Avenue Partner',
    amount: '$500',
    gets: 'Everything above, plus your logo on event signage, a newsletter mention, and an invitation to the annual supporter gathering.',
  },
  {
    name: 'Boulevard Partner',
    amount: '$1,000',
    gets: 'Everything above, plus featured logo placement and a dedicated social spotlight.',
  },
  {
    name: 'Freeway Partner',
    amount: '$1,500 and up',
    gets: 'Everything above, plus the option to co-brand an event or initiative, and first invitation to corporate match conversations.',
  },
];

/*
 * Details are inferred from the titles and are written to describe intent
 * rather than to commit anyone to specifics. The March line named Twin Valley
 * Coffee until nothing turned out to be confirmed with them: a title naming a
 * business states a joint event as fact, whatever the description underneath
 * is careful to avoid. It stays unnamed until there is an agreement to point
 * at. All five need founder sign-off before launch.
 */
const milestones = [
  {
    when: 'September',
    what: 'Fundraising begins',
    detail:
      'The fund opens for the year. From this point every gift goes toward the first award.',
  },
  {
    when: 'November',
    what: 'High school reunions fundraiser',
    detail:
      'Reunion season brings people back to West Chester. We make the case in person, to the people who went to these schools themselves.',
  },
  {
    when: 'January',
    what: 'WCASD essay contest',
    detail:
      'A writing prize across the district. It raises money and it puts the fund in front of the students who might apply to it.',
  },
  {
    when: 'March',
    what: 'Fundraising day with a local coffee shop',
    detail:
      'A day at a local shop, with the community invited to come by and give. The last push before the award is decided.',
  },
  {
    when: 'April',
    what: 'First round of scholarships',
    detail:
      'The district committee and the founders read together, and the first award is made.',
  },
];

const donorFaqs = [
  {
    q: 'Is my donation tax-deductible?',
    a: "Yes. We're a registered 501(c)(3) nonprofit organization, and you'll get a receipt for your records.",
  },
  {
    q: 'Can I give monthly?',
    a: "Not at launch. A gift is a one-time thing for now. Recurring giving arrives when there's a reason for it.",
  },
  {
    q: 'What if you raise more than $10,000?',
    a: "It seeds next year's fund. Anything past the goal carries into the next cycle rather than sitting still.",
  },
  {
    q: 'Who runs this?',
    a: 'Five people from West Chester, named with our roles on the About us page.',
  },
];
---

<BaseLayout
  title="Get involved | The Open Road Foundation"
  description="Give, partner, or tell us you're interested. We're raising $10,000 this year to fund a West Chester Area School District student."
>
  <PageHero
    heading="Get involved"
    lede="We're raising $10,000 this year to fund our first student. Here's every way to help, including one that costs nothing but the time it takes to fill in a form."
  />

  <!-- Four ways in, before any of the detail. This page used to open on eight
       stacked prose sections with no map, so a visitor had to read it to find
       out what they were being asked to do. Four blocks let them choose. -->
  <section class="section surface-base">
    <div class="wrap">
      <h2 class="ways-title reveal">Four ways to help</h2>
      <ul class="ways">
        {
          ways.map((w, i) => (
            <li class="way reveal" style={`--reveal-delay:${i * 110}ms`}>
              <a href={w.href}>
                <span class="way-icon"><Icon name={w.icon} /></span>
                <span class="way-name">{w.name}</span>
                <span class="way-note">{w.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Deliberately not captioned as one of our events, because it is not one.
       It is a stock photograph of people giving, standing in until there is a
       photograph of this fund's own first fundraiser to replace it. The alt
       text describes what is in the frame and claims nothing else. -->
  <figure class="giving-band reveal">
    <div class="giving-media">
      <Image
        src={givingPhoto}
        alt="People waiting in line at an indoor event beside a table holding two woven collection baskets, one person reaching in to place something inside."
        widths={[768, 1280, 1600]}
        sizes="100vw"
        loading="lazy"
      />
    </div>
  </figure>

  <!-- Moved up, ahead of every ask. A visitor should see what the year
       actually looks like before being asked to fund it. -->
  <section class="section--major surface-panel" id="plan">
    <div class="wrap">
      <div class="plan-grid">
        <div>
          <h2 class="plan-title reveal">The plan for year one</h2>
          <p class="plan-goal">
            <span class="plan-goal-label">Year-one goal</span>
            <span class="plan-goal-figure">$10,000</span>
          </p>
          <p class="plan-note">
            Every dollar raised goes into the Open Road Fund. Running the foundation, the
            fundraising, the marketing and the administrative work behind an award, is paid for by
            the founders. Anything raised past the goal carries into next year's fund rather than
            sitting still.
          </p>
        </div>
        <MilestoneRail items={milestones} />
      </div>
    </div>
  </section>

  <section class="section surface-base" id="give">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">Give</h2>
        <p>
          One gift, one student, this year. There's no recurring giving at launch. When you give,
          it's once, and it goes toward the award.
        </p>
        <p>
          <strong>Your gift is tax-deductible.</strong> We're a registered 501(c)(3) nonprofit
          organization, EIN <Placeholder note="EIN" as="inline" />, and you'll get a receipt for
          your records.
        </p>
        <p>
          <Button placeholder>Donate</Button>
        </p>
      </div>
    </div>
  </section>

  <section class="section surface-panel" id="partner">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">Partner with us</h2>
        <p>
          For businesses, community organizations, and anyone who wants to give at a level that
          carries their name alongside ours.
        </p>
      </div>

      <!-- Tiers are named after road types and ascend in scale, so the naming
           does real work: the reader can order them without reading amounts.

           The tiles express that ascent through elevation rather than through a
           coloured rule. Each step lifts further off the page, and the top tier
           inverts to the deep surface so it genuinely stands apart. Reuses the
           .surface-* classes, so no new colour rules. -->
      <ul class="tiers">
        {
          tiers.map((tier, i) => (
            <li
              class={`tier tier--${i + 1} reveal ${i === tiers.length - 1 ? 'surface-deep' : ''}`}
              style={`--reveal-delay:${i * 110}ms`}
            >
              <p class="tier-amount">{tier.amount}</p>
              <p class="tier-name">{tier.name}</p>
              <p class="tier-gets">{tier.gets}</p>
            </li>
          ))
        }
      </ul>

      <p class="tiers-note">
        Recognition on printed materials and at events depends on what we produce this year. We'll
        tell you what's real before you commit.
      </p>
    </div>
  </section>

  <section class="section surface-base">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">Employer matching</h2>
        <p>
          Many employers match charitable gifts from their staff, which can double what you give at
          no extra cost to you. Ask your HR team for their matching gift form.
        </p>
        <p>You'll need:</p>
        <Placeholder note="legal name, EIN, registered address" />
      </div>
    </div>
  </section>

  <section class="section surface-panel" id="newsletter">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">Newsletter</h2>
        <p>
          One email when there's something real to report: the application opening, a student
          funded, the year's total. That's it, and we won't pass your address to anyone.
        </p>
        <p><Button placeholder>Join the newsletter</Button></p>
      </div>
    </div>
  </section>

  <section class="section--major surface-base" id="interest">
    <div class="wrap">
      <h2 class="interest-title reveal">Tell us you're interested</h2>
      <InterestForm />
    </div>
  </section>

  <section class="section surface-panel">
    <div class="wrap">
      <div class="split faq-split">
        <h2 class="faq-title reveal">Questions from donors</h2>
        <Faq items={donorFaqs} />
      </div>
    </div>
  </section>

  <CtaBand heading="Open the road, and see what comes back.">
    <p slot="body">
      We're raising the first award now, and giving it to one WCASD student by the end of the school
      year.
    </p>
    <Button href="#give">Support a student</Button>
  </CtaBand>
</BaseLayout>

<style>
  .faq-split > :not(h2, h3) {
    max-inline-size: none;
  }

  .faq-title {
    margin-block: 0;
  }

  /* --- ways to help ---------------------------------------------------- */

  .ways-title {
    margin: 0 0 var(--space-l);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  .ways {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .ways {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .way a {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    gap: var(--space-2xs);
    padding: var(--space-m);
    border-radius: var(--radius-panel);
    border: var(--border-hairline) solid var(--rule);
    background-color: var(--bg);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--duration) var(--ease-spring),
      border-color var(--duration) var(--ease-spring);
  }

  .way a:hover {
    transform: translateY(-2px);
    border-color: var(--rule-strong);
  }

  .way a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .way-icon {
    inline-size: 1.75rem;
    color: var(--fg);
    margin-block-end: var(--space-2xs);
  }

  .way-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .way-note {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--fg-quiet);
  }


  /* There are exactly four tiers and they are a sequence, so they belong on one
     line. auto-fit was deciding the column count from a 15rem minimum, which
     drops to three columns as soon as the reader's base font size is a little
     larger than default and leaves the top tier stranded on a row of its own.
     The steps are pinned instead: one, then two, then all four. */
  .tiers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .tiers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-s);
    }
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-m);
    border-radius: var(--radius-panel);
  }

  /* Only the light tiles paint their own ground. The top tier carries
     .surface-deep, which sets both background and foreground; setting a
     paper background here as well would win on specificity and leave that tile
     rendering paper text on paper. */
  .tier:not(.surface-deep) {
    background-color: var(--color-surface);
  }

  /* The ascent, in four steps.
     This used to be four steps of drop shadow, which made the tiles read as
     UI cards floating over the page rather than as part of it. The sequence
     is the same, expressed in weight rather than depth: hairline, stronger
     hairline, 2px, then the dark band. Shadow is reserved for things that
     genuinely float above the page, which none of these do. */
  .tier--1 {
    border: var(--border-hairline) solid var(--rule);
  }

  .tier--2 {
    border: var(--border-hairline) solid var(--rule-strong);
  }

  /* Full-strength deep, not a panel ground: these tiles sit ON the panel
     surface already, so a panel background would have made the third tile
     disappear. 2px of the actual foreground colour is the last step before
     the fourth tile fills with it. */
  .tier--3 {
    border: 2px solid var(--fg);
  }

  .tier-name {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  /* The amount carries the hierarchy now that no coloured rule does. */
  .tier-amount {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .tier-gets {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .tiers-note {
    margin: var(--space-m) 0 0;
    max-inline-size: var(--width-text);
    font-size: var(--text-sm);
    color: var(--fg-quiet);
  }

  .plan-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .plan-title {
    margin: 0 0 var(--space-m);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  .plan-goal {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin: 0;
  }

  .plan-goal-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  .plan-note {
    margin: var(--space-m) 0 0;
    max-inline-size: 30rem;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .plan-goal-figure {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .interest-title,
  .faq-title {
    margin: 0 0 var(--space-l);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  .faq-extra {
    margin: var(--space-l) 0 var(--space-s);
    max-inline-size: var(--width-text);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .faq-extra strong {
    color: var(--fg);
  }

  @media (max-width: 60rem) {
    .plan-grid {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  /* A tall source in a wide band, so the crop is severe by design: it holds the
     baskets and the hands at the table and drops most of the room. Taking the
     upper-middle slice keeps the queue in frame without turning it into a row
     of portraits, which is the read this page should not have. */
  .giving-band {
    margin: 0;
  }

  .giving-media {
    position: relative;
    isolation: isolate;
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }

  .giving-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* Tuned by rendering the band at four positions and looking. At 50%/62%
       the frame filled with torsos and one face, which is the row-of-portraits
       read this page should not have. This lands on the baskets, the table and
       the reaching hand, and pushes every face above the top edge. */
    object-position: 38% 74%;
    /* The source runs cool and blue, which fights a warm apricot and deep teal
       palette. Pulled back before the multiply layer lands on it. */
    filter: saturate(0.55);
  }

  .giving-media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background-color: var(--color-deep);
    mix-blend-mode: multiply;
    opacity: 0.3;
  }

  /* Weighted to the bottom edge, which is doing a second job besides grounding
     the band: a bin and a table leg sit in the lower left of this crop, and the
     falloff buries them. */
  .giving-media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgb(31 78 74 / 0.24), rgb(31 78 74 / 0.06) 45%, rgb(31 78 74 / 0.62));
  }

  @media (max-width: 48rem) {
    .giving-media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
