---
import { DONATE_URL } from '../consts';
import { Image } from 'astro:assets';
import lectureHall from '../assets/lecture-hall.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import MilestoneRail from '../components/MilestoneRail.astro';
import InterestForm from '../components/InterestForm.astro';
import Icon from '../components/Icon.astro';

/* A drafted email with the site's address in it. No script, so it works
 * anywhere, and the note on the card says exactly what happens. */
const SHARE_HREF =
  'mailto:?subject=The%20Open%20Road%20Foundation&body=A%20community%20scholarship%20endowment%20for%20West%20Chester%20Area%20School%20District%20students%3A%20https%3A%2F%2Ftheopenroadfoundation.org%2F';

const ways = [
  { icon: 'give',    name: 'Give',                     note: 'Invested, and paid out as scholarships every year.', href: '#give' },
  { icon: 'partner', name: 'Partner with us',          note: 'For businesses and community organizations.', href: '#partner' },
  { icon: 'ask',     name: "Tell us you're interested", note: 'Student, parent, counselor, mentor, donor.', href: '#interest' },
  { icon: 'tell',    name: 'Spread the word',          note: 'Send this to someone in West Chester.', href: SHARE_HREF },
] as const;

/*
 * The tiers are the sponsor sheet's, word for word. The sheet is the source of
 * truth for sponsorship, and the two used to offer different things to the
 * same businesses (Freeway was $1,500 here and $2,500 there).
 */
const tiers = [
  {
    name: 'Founding Supporter',
    amount: 'Up to $499',
    gets: [
      'A personal letter of appreciation from the founders',
      'Your name on the supporters page, in text, for the year',
    ],
  },
  {
    name: 'Avenue Partner',
    amount: '$500',
    prev: 'Founding Supporter, plus:',
    gets: ['Your logo on event signage', 'A newsletter mention', 'An Instagram and Facebook story'],
  },
  {
    name: 'Boulevard Partner',
    amount: '$1,000',
    prev: 'Avenue Partner, plus:',
    gets: [
      'A spotlight post on Instagram, Facebook and LinkedIn',
      'Your name and logo on the site and in print',
    ],
  },
  {
    name: 'Freeway Partner',
    amount: '$2,500+',
    prev: 'Boulevard Partner, plus:',
    gets: [
      'Top logo placement on the site and in print',
      'A social feature or reel, planned with you',
      'Recognition at Open Road events',
      'A yearly note on what your partnership paid for',
      'The Open Road 2027 Scholarship, presented by you',
    ],
  },
];

/*
 * The 2026-27 schedule from the FAQ, as of 15 September 2026. Days are given
 * where the FAQ gives them. The March coffee shop day is gone: the FAQ has no
 * programming in March.
 */
const milestones = [
  {
    when: 'September 1',
    what: 'Fundraising kicks off',
    detail: 'The fund opens for the year, through individual gifts, events and corporate match programs.',
  },
  {
    when: 'November 21',
    what: 'Percentage night with Chipotle West Chester',
    detail: 'Come in for dinner, and part of the evening goes to the fund.',
  },
  {
    when: 'November',
    what: 'WCASD class of 2021 reunions',
    detail: 'West Chester East on November 28. Henderson and Rustin are finalizing their dates, and both have agreed to partner.',
  },
  {
    when: 'January',
    what: 'Charity Giving Program at Sedona Taphouse',
    detail: "All month, through Sedona Taphouse's own giving program.",
  },
  {
    when: 'January 15',
    what: 'The essay contest opens',
    detail: 'Seniors apply with a personal statement.',
  },
  {
    when: 'April 15',
    what: 'The winner is announced',
  },
  {
    when: 'May 1',
    what: 'Our first scholarship is paid',
    detail: 'Directly to the student, as a check.',
  },
];

const donorFaqs = [
  {
    q: 'Where does my money go?',
    a: 'Into our community endowment fund: secure investments, such as government bonds, that grow passively. We award money from the fund each year while keeping enough in it to grow year over year. We can share our investment strategy on request.',
  },
  {
    q: 'How much of it reaches students?',
    a: 'Gifts go into the fund, and its investments add returns on top. Together they pay for scholarships each year, while enough stays invested for the fund to keep growing.',
  },
  {
    q: 'Is my donation tax-deductible?',
    a: 'Yes. We are a registered 501(c)(3) nonprofit organization, and you will get a receipt for your records.',
  },
  {
    q: 'Can I give monthly?',
    a: 'Yes. Choose Monthly when you give.',
  },
  {
    q: 'What if you raise more than $10,000?',
    a: 'It all goes into the endowment. A bigger fund earns more, so every scholarship after it grows too.',
  },
  {
    q: 'Who runs this?',
    a: 'Five people from West Chester, named with our roles on the About us page.',
  },
];
---

<BaseLayout
  title="Get involved | The Open Road Foundation"
  description="Give, sponsor, or tell us you are interested. We are raising $10,000 this year to start a community scholarship endowment for West Chester Area School District students."
>
  <PageHero
    heading="Get involved"
    lede="We are raising $10,000 this year to start a community scholarship endowment for WCASD students. Every way to help is below, and one of them takes only a minute and a form."
  />

  <!-- Four ways in, before any of the detail. This page used to open on eight
       stacked prose sections with no map, so a visitor had to read it to find
       out what they were being asked to do. Four blocks let them choose. -->
  <section class="section surface-base">
    <div class="wrap">
      <h2 class="ways-title reveal">Four ways to help</h2>
      <ul class="ways">
        {
          ways.map((w, i) => (
            <li class="way reveal" style={`--reveal-delay:${i * 110}ms`}>
              <a href={w.href}>
                <span class="way-icon"><Icon name={w.icon} /></span>
                <span class="way-name">{w.name}</span>
                <span class="way-note">{w.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- No people in frame, on purpose. An earlier version showed a queue of
       strangers at someone else's fundraiser, which put faces on a page asking
       for money toward an event that has not happened yet. An empty room says
       the same thing without borrowing anyone: a seat, and the money it takes
       to sit in it. -->
  <figure class="giving-band reveal">
    <div class="giving-media">
      <Image
        src={lectureHall}
        alt="An empty modern lecture hall with curved timber desks and upholstered seats rising in tiers, lit by a full-height glass wall looking onto trees."
        widths={[768, 1280, 1600]}
        sizes="100vw"
        loading="lazy"
      />
    </div>
  </figure>

  <!-- Moved up, ahead of every ask. A visitor should see what the year
       actually looks like before being asked to fund it. -->
  <section class="section--major surface-panel" id="plan">
    <div class="wrap">
      <div class="plan-grid">
        <div>
          <h2 class="plan-title reveal">The plan for year one</h2>
          <p class="plan-goal">
            <span class="plan-goal-label">Year-one goal</span>
            <span class="plan-goal-figure">$10,000</span>
          </p>
          <p class="plan-note">
            Every dollar raised goes into the community endowment, where it is invested in secure
            holdings such as government bonds. Running the foundation, the fundraising, the
            marketing and the administrative work behind an award, is paid for by the founders.
          </p>
          <p class="plan-note">Our schedule for the 2026 to 2027 school year, as of September.</p>
        </div>
        <MilestoneRail items={milestones} />
      </div>
    </div>
  </section>

  <section class="section surface-base" id="give">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">Give</h2>
        <p>
          A gift here goes into the community endowment, where it is invested to grow. Gifts and
          the fund's returns together pay for scholarships every year, so what you give keeps
          working.
        </p>
        <p>
          <strong>Your gift is tax-deductible.</strong> We are a registered 501(c)(3) nonprofit
          organization, <span class="nowrap">EIN 42-3704788</span>, and you will get a receipt for
          your records.
        </p>

        <p>
          Give once or monthly, and your receipt comes by email.
        </p>
        <p>
          <Button href={DONATE_URL}>Donate</Button>
        </p>

        <!-- Employer matching sits with the ask it doubles. -->
        <div class="give-match">
          <h3>Employer matching</h3>
          <p>
            Many employers match charitable gifts from their staff, which can double what you give at
            no extra cost to you. Ask your HR team for their matching gift form.
          </p>
          <p>You'll need:</p>
          <ul class="matching-facts">
            <li><span>Legal name</span>The Open Road Foundation</li>
            <li><span>EIN</span>42-3704788</li>
            <li><span>Address</span>1427 Clover Lane, West Chester, PA 19380-5906</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-panel" id="partner">
    <div class="wrap">
      <h2 class="ways-title partner-title reveal">Ways to partner</h2>

      <!-- Tiers are named after road types and ascend in scale, so the naming
           does real work: the reader can order them without reading amounts.

           The tiles express that ascent through elevation rather than through a
           coloured rule. Each step lifts further off the page, and the top tier
           inverts to the deep surface so it genuinely stands apart. Reuses the
           .surface-* classes, so no new colour rules. -->
      <ul class="tiers">
        {
          tiers.map((tier, i) => (
            <li
              class={`tier tier--${i + 1} reveal ${i === tiers.length - 1 ? 'surface-deep' : ''}`}
              style={`--reveal-delay:${i * 110}ms`}
            >
              <p class="tier-amount">{tier.amount}</p>
              <p class="tier-name">{tier.name}</p>
              {tier.prev && <p class="tier-prev">{tier.prev}</p>}
              <ul class="tier-gets">
                {tier.gets.map((g) => <li>{g}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>

            <!-- Two notes, each exactly two tier columns wide on a wide screen, so
           their edges line up with the cards above. Same order and wording as
           the sponsor sheet. Destination Partner ($5,000 and up) is no longer
           listed: it is kept back as a ghost tier and offered in conversation,
           which is what the second note invites. -->
      <div class="tier-notes">
        <div class="tier-note reveal">
          <p class="tier-note-head">
            <span class="tier-note-title">Giving in kind</span>
            <span class="tier-note-tag">Any size</span>
          </p>
          <p class="tier-note-text">
            Goods, space, printing, food or professional time all lower what the fund has to spend.
          </p>
        </div>
        <div class="tier-note reveal" style="--reveal-delay:110ms">
          <p class="tier-note-head">
                        <span class="tier-note-title">Something else</span>
            <span class="tier-note-tag">Let's talk</span>
          </p>
          <p class="tier-note-text">
                        If none of these options are compatible with your interests, we'll discuss what's
            best for you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section--major surface-base" id="interest">
    <div class="wrap">
      <h2 class="interest-title reveal">Tell us you're interested</h2>
      <InterestForm />
    </div>
  </section>

  <section class="section surface-panel">
    <div class="wrap">
      <div class="split faq-split">
        <h2 class="faq-title reveal">Questions from donors</h2>
        <Faq items={donorFaqs} />
      </div>
    </div>
  </section>

  <CtaBand heading="This is the year it starts.">
    <p slot="body">
      We're building the fund now, and our first scholarship goes to a WCASD senior on May 1.
    </p>
    <Button href={DONATE_URL}>Support a student</Button>
  </CtaBand>
</BaseLayout>

<style>
  .faq-split > :not(h2, h3) {
    max-inline-size: none;
  }

  .faq-title {
    margin-block: 0;
  }

  /* --- ways to help ---------------------------------------------------- */

  .ways-title {
    margin: 0 0 var(--space-l);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  .ways {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .ways {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* The whole card is the target, so it reads as one: larger type and a
     larger icon. The hover is a lift and a shadow fading in on its own layer,
     so only transform and opacity animate. No arrow: the lift, the shadow and
     the pointer already say the card goes somewhere. */
  .way a {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    block-size: 100%;
    gap: var(--space-2xs);
    padding: var(--space-l);
    border-radius: var(--radius-panel);
    border: var(--border-hairline) solid var(--rule);
    background-color: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration) var(--ease-spring);
  }

  .way a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow: var(--shadow-floating);
    opacity: 0;
    transition: opacity var(--duration) var(--ease-spring);
  }

  .way a:hover {
    transform: translateY(-4px);
    border-color: var(--rule-strong);
  }

  .way a:hover::after,
  .way a:focus-visible::after {
    opacity: 1;
  }

  .way a:active {
    transform: translateY(-1px);
  }

  .way a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .way-icon {
    inline-size: 2.25rem;
    color: var(--fg);
    margin-block-end: var(--space-xs);
  }

  .way-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.2;
  }

  .way-note {
    line-height: 1.55;
    color: var(--fg-quiet);
  }

  @media (prefers-reduced-motion: reduce) {
    .way a,
    .way a::after {
      transition: none;
    }
  }

  /* There are exactly four tiers and they are a sequence, so they belong on one
     line. auto-fit was deciding the column count from a 15rem minimum, which
     drops to three columns as soon as the reader's base font size is a little
     larger than default and leaves the top tier stranded on a row of its own.
     The steps are pinned instead: one, then two, then all four. */
  .tiers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .tiers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-s);
    }
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-m);
    border-radius: var(--radius-panel);
  }

  /* Only the light tiles paint their own ground. The top tier carries
     .surface-deep, which sets both background and foreground; setting a
     paper background here as well would win on specificity and leave that tile
     rendering paper text on paper. */
  .tier:not(.surface-deep) {
    background-color: var(--color-surface);
  }

  /* The ascent, in four steps.
     This used to be four steps of drop shadow, which made the tiles read as
     UI cards floating over the page rather than as part of it. The sequence
     is the same, expressed in weight rather than depth: hairline, stronger
     hairline, 2px, then the dark band. Shadow is reserved for things that
     genuinely float above the page, which none of these do. */
  .tier--1 {
    border: var(--border-hairline) solid var(--rule);
  }

  .tier--2 {
    border: var(--border-hairline) solid var(--rule-strong);
  }

  /* Full-strength deep, not a panel ground: these tiles sit ON the panel
     surface already, so a panel background would have made the third tile
     disappear. 2px of the actual foreground colour is the last step before
     the fourth tile fills with it. */
  .tier--3 {
    border: 2px solid var(--fg);
  }

  .tier-name {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  /* The amount carries the hierarchy now that no coloured rule does. */
  .tier-amount {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  /* Semibold, not italic: only upright Figtree is loaded, so an italic here
     would be a slanted fake. Matches the sponsor sheet. */
  .tier-prev {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg-quiet);
  }

  /* Hanging markers, so a wrapped line starts under the text rather than under
     the dot. Same round marker as the checklist elsewhere on the site. */
  .tier-gets {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--fg-quiet);
  }

  .tier-gets li {
    position: relative;
    padding-inline-start: var(--space-s);
  }

  .tier-gets li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.1rem;
    inset-block-start: 0.68em;
    inline-size: 0.3rem;
    block-size: 0.3rem;
    border-radius: 50%;
    background-color: currentColor;
  }

  .partner-title + .tiers {
    margin-block-start: 0;
  }

  .tier-notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    margin-block-start: var(--space-m);
  }

  /* Gaps match the tier grid at each width, which is what makes each note
     exactly two tier columns wide. */
  @media (min-width: 40rem) {
    .tier-notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .tier-notes {
      gap: var(--space-s);
      margin-block-start: var(--space-s);
    }
  }

  .tier-note {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-m);
    border-radius: var(--radius-panel);
    border: var(--border-hairline) solid var(--rule-strong);
  }

  .tier-note p {
    margin: 0;
  }

  .tier-note .tier-note-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
    padding-block-end: var(--space-2xs);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  .tier-note-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--fg);
  }

  .tier-note-tag {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  .tier-note .tier-note-text {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .matching-facts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: var(--space-m);
    list-style: none;
    border: var(--border-hairline) solid var(--rule);
    border-radius: var(--radius-panel);
    background-color: var(--color-surface);
  }

  .matching-facts li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem var(--space-2xs);
    font-size: var(--text-sm);
  }

  /* The label sits on a fixed rail so the three values line up, and wraps to
     its own line before that rail would squeeze the address. */
  .matching-facts span {
    flex: 0 0 5.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
    padding-block-start: 0.2em;
  }

  .plan-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .plan-title {
    margin: 0 0 var(--space-m);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  .plan-goal {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin: 0;
  }

  .plan-goal-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  .plan-note {
    margin: var(--space-m) 0 0;
    max-inline-size: 30rem;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .plan-goal-figure {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  /* An EIN is one token; it must not break at its hyphen. */
  .nowrap {
    white-space: nowrap;
  }

  .give-match {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-l);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .give-match h3,
  .give-match p {
    margin: 0;
  }

  .give-match h3 {
    font-size: var(--text-xl);
  }

  .interest-title,
  .faq-title {
    margin: 0 0 var(--space-l);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  .faq-extra {
    margin: var(--space-l) 0 var(--space-s);
    max-inline-size: var(--width-text);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .faq-extra strong {
    color: var(--fg);
  }

  @media (max-width: 60rem) {
    .plan-grid {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
  }

  /* A wide slice through the middle of the room, which keeps the arched window
     and the far rows in frame and drops the empty ceiling. */
  .giving-band {
    margin: 0;
  }

  .giving-media {
    position: relative;
    isolation: isolate;
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }

  .giving-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* Centred. The source is 2.24:1 against a 21:9 band, so this is very
       nearly a straight fit and there is no crop worth biasing. */
    object-position: 50% 50%;
    filter: saturate(0.9);
  }

  .giving-media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background-color: var(--color-deep);
