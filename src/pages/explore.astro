---
/**
 * Identity exploration. Temporary: delete once a direction is chosen.
 *
 * Marks, palettes and type are shown in context rather than as a description,
 * because a mark cannot be judged from prose. The 16px row is the honest test.
 */
import '@fontsource-variable/newsreader';
import '@fontsource-variable/archivo';
// Candidate faces, loaded so the comparison is real rather than three rows of
// the same type. Unused ones get uninstalled once a direction is chosen.
import '@fontsource-variable/literata';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/600.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Marks from '../components/explore/Marks.astro';

const marks = [
  { name: 'aperture', label: 'Aperture', note: 'An opening iris. Vision widening. The steadiest of the five at small sizes: it collapses to a ring and a core and still reads.' },
  { name: 'shift', label: 'Shift', note: 'One square, drawn twice, the second turned. The same subject from a different angle. The plainest possible statement of perspective, and the most legible mark here.' },
  { name: 'prism', label: 'Prism', note: 'One line goes in, three come out. A single student, and the wider range of what they can see afterwards.' },
  { name: 'frame', label: 'Frame', note: 'Four corners, then four further out. Broadening what you take in, said as a crop mark rather than a landscape.' },
  { name: 'vista', label: 'Vista', note: 'An arch with a second arch behind it. A way through, with depth beyond. Architectural rather than scenic, so it avoids a literal horizon.' },
] as const;

const palettes = [
  {
    id: 'meridian',
    label: 'A. Meridian',
    note: 'Indigo ground, cool paper, brass signal. Trust with warmth. The coolest surfaces of the three, so the warm accent has somewhere to land.',
    ground: '#16233a',
    surface: '#f4f6f8',
    second: '#e3e8ed',
    quiet: '#4a5a70',
    accent: '#c98a2e',
    accentText: '#8a5c12',
  },
  {
    id: 'evergreen',
    label: 'B. Evergreen',
    note: 'Forest ground, bone surface, muted gold. Rooted and institutional. Reads as the most established of the three.',
    ground: '#17332a',
    surface: '#f4f7f4',
    second: '#e0e7e0',
    quiet: '#485a50',
    /* Lifted from #b8873a, which put forest-on-gold at 4.25:1, just under the
       floor. This is the constraint being designed in rather than discovered
       after launch, which is what happened with the current amber. */
    accent: '#c08f42',
    accentText: '#7a5718',
  },
  {
    id: 'graphite',
    label: 'C. Graphite',
    note: 'Warm stone neutrals with one loud signal. Near-monochrome, most design-forward, and the accent can actually carry text.',
    ground: '#22252a',
    surface: '#f6f5f3',
    second: '#e8e6e2',
    quiet: '#55585e',
    accent: '#c4442e',
    accentText: '#a5341f',
    /* Vermilion is dark enough that the ground on top of it is only 2.4:1.
       This one takes a light label instead. The same trap the current amber
       fell into, caught here rather than after launch. */
    onAccent: '#f6f5f3',
  },
];

const typePairs = [
  {
    label: '1. Literata + IBM Plex Sans',
    note: 'Sturdy reading serif against an engineered sans. Institutional and credible; the most neutral of the three.',
    display: "'Literata Variable', Georgia, serif",
    body: "'IBM Plex Sans Variable', system-ui, sans-serif",
  },
  {
    label: '2. Spectral + Atkinson Hyperlegible',
    note: 'Atkinson was drawn by the Braille Institute for low-vision readers. The body face would carry the foundation’s own values about access, which is a better reason than highway signage lineage.',
    display: "'Spectral', Georgia, serif",
    body: "'Atkinson Hyperlegible', system-ui, sans-serif",
  },
  {
    label: '3. Source Serif 4 + Figtree',
    note: 'Quiet and modern, the least mannered of the three. Figtree is warmer and rounder than the other two body faces.',
    display: "'Source Serif 4 Variable', Georgia, serif",
    body: "'Figtree Variable', system-ui, sans-serif",
  },
  {
    label: '4. Current: Newsreader + Archivo',
    note: 'Shown for comparison. Archivo was chosen for its highway signage lineage, which is the rationale now in question.',
    display: "'Newsreader Variable', Georgia, serif",
    body: "'Archivo Variable', system-ui, sans-serif",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Identity exploration</title>
  </head>
  <body class="surface-paper">
    <header class="x-head wrap">
      <p class="x-kicker">Identity exploration</p>
      <h1>Five marks, three palettes, four type pairings.</h1>
      <p class="x-lede">
        Everything here is a candidate. Nothing is applied to the site yet. The idea underneath all
        five marks is perspective: going somewhere unfamiliar changes what you can see. None of them
        contains a road, a mortarboard or a figure.
      </p>
    </header>

    <!-- MARKS ------------------------------------------------------------ -->
    <section class="wrap x-section">
      <h2>The marks</h2>
      <p class="x-note">
        Each row runs 200 / 96 / 32 / 16px, on light and on dark. The 16px column is the real test,
        which is where the current mark falls apart.
      </p>

      {
        marks.map((m) => (
          <article class="mark-row">
            <div class="mark-meta">
              <h3>{m.label}</h3>
              <p>{m.note}</p>
            </div>

            <div class="mark-sizes surface-paper">
              <div style="width:200px"><Marks name={m.name} /></div>
              <div style="width:96px"><Marks name={m.name} /></div>
              <div style="width:32px"><Marks name={m.name} /></div>
              <div style="width:16px"><Marks name={m.name} /></div>
            </div>

            <div class="mark-sizes mark-sizes--dark">
              <div style="width:200px"><Marks name={m.name} /></div>
              <div style="width:96px"><Marks name={m.name} /></div>
              <div style="width:32px"><Marks name={m.name} /></div>
              <div style="width:16px"><Marks name={m.name} /></div>
            </div>
          </article>
        ))
      }
    </section>

    <!-- PALETTES --------------------------------------------------------- -->
    <section class="wrap x-section">
      <h2>The palettes</h2>
      <p class="x-note">
        Shown as working UI, not chips. None uses a cream ground. Each ships a darker variant of its
        accent that can actually carry text, which the current amber cannot.
      </p>

      <div class="pal-grid">
        {
          palettes.map((p) => (
            <article
              class="pal"
              style={`--g:${p.ground};--s:${p.surface};--s2:${p.second};--q:${p.quiet};--a:${p.accent};--at:${p.accentText};--on-a:${p.onAccent ?? p.ground}`}
            >
              <header class="pal-head">
                <h3>{p.label}</h3>
                <p>{p.note}</p>
              </header>

              <div class="pal-chips">
                <span style="background:var(--g)" />
                <span style="background:var(--s2)" />
                <span style="background:var(--s)" />
                <span style="background:var(--a)" />
              </div>

              <div class="pal-demo">
                <div class="pal-band">
                  <span class="pal-eyebrow">West Chester, Pennsylvania</span>
                  <p class="pal-h">Some roads are worth leaving home for.</p>
                  <span class="pal-btn">Support a student</span>
                </div>

                <div class="pal-body">
                  <p class="pal-stat">1 in 8</p>
                  <p class="pal-copy">
                    About one in eight of the district's 12,042 students is economically
                    disadvantaged. <a href="#0">See where every dollar goes.</a>
                  </p>
                  <div class="pal-tile">
                    <p class="pal-tile-amt">$1,500 and up</p>
                    <p class="pal-tile-name">Freeway Partner</p>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- TYPE ------------------------------------------------------------- -->
    <section class="wrap x-section">
      <h2>The type</h2>
      <p class="x-note">
        These are the real families, loaded and set, not substitutes. The fourth row is what the
        site uses today, for comparison. Type and palette are independent, so any pairing can go with
        any palette.
      </p>

      {
        typePairs.map((t) => (
          <article class="type-row">
            <div class="type-meta">
              <h3>{t.label}</h3>
              <p>{t.note}</p>
            </div>
            <div class="type-demo">
              <p class="type-h" style={`font-family:${t.display}`}>
                Open the road, and see what comes back.
              </p>
              <p class="type-b" style={`font-family:${t.body}`}>
                The five of us grew up here, and we all left for school. What we found out there was
                perspective: long stretches away, surrounded by people whose lives looked nothing
                like ours.
              </p>
            </div>
          </article>
        ))
      }
    </section>

    <!-- SIGNATURE -------------------------------------------------------- -->
    <section class="wrap x-section">
      <h2>Replacing the lane</h2>
      <p class="x-note">
        The dashed lane marking retires with the logo. Its successor has to do the same structural
        work: dividers, nav indicator, FAQ toggle, stat rules. A graduated rule keeps the perspective
        logic (nearer reads heavier) without saying highway.
      </p>
      <div class="rule-demo">
        <span class="rule-old" />
        <p class="x-caption">Current: dashed lane marking.</p>
        <span class="rule-new" />
        <p class="x-caption">Proposed: graduated rule, thickening as it approaches.</p>
      </div>
    </section>

    <footer class="wrap x-foot">
      <p>Temporary page. Deleted once a direction is chosen.</p>
    </footer>
  </body>
</html>

<style>
  body {
    padding-block: var(--space-2xl);
  }

  .x-head {
    padding-block-end: var(--space-xl);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  .x-kicker {
    margin: 0 0 var(--space-2xs);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  .x-head h1 {
    margin: 0;
    max-inline-size: 20ch;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .x-lede {
    margin: var(--space-m) 0 0;
    max-inline-size: var(--width-text);
    color: var(--fg-quiet);
    line-height: var(--leading-body);
  }

  .x-section {
    padding-block: var(--space-2xl);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  .x-section h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .x-note {
    margin: var(--space-s) 0 var(--space-xl);
    max-inline-size: var(--width-text);
    color: var(--fg-quiet);
    line-height: var(--leading-body);
  }

  .x-caption {
    margin: 0.35rem 0 var(--space-m);
    font-size: var(--text-xs);
    color: var(--fg-quiet);
  }

  /* --- marks --------------------------------------------------------- */

  .mark-row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.1fr) minmax(0, 1.1fr);
    gap: var(--space-m);
    align-items: center;
    padding-block: var(--space-l);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .mark-meta h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-xl);
  }

  .mark-meta p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .mark-sizes {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-m);
    padding: var(--space-m);
    border-radius: var(--radius-panel);
    color: var(--color-asphalt);
    --mark-accent: var(--color-amber);
  }

  .mark-sizes--dark {
    background-color: var(--color-asphalt);
    color: var(--color-paper);
  }

  /* --- palettes ------------------------------------------------------ */

  .pal-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }

  @media (min-width: 64rem) {
    .pal-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pal-head h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-xl);
  }

  .pal-head p {
    margin: 0 0 var(--space-s);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .pal-chips {
    display: flex;
    gap: 4px;
    margin-block-end: var(--space-s);
  }

  .pal-chips span {
    flex: 1;
    block-size: 2.5rem;
    border-radius: 2px;
  }

  .pal-demo {
    border-radius: var(--radius-panel);
    overflow: hidden;
    border: var(--border-hairline) solid var(--rule);
  }

  .pal-band {
    padding: var(--space-m);
    background-color: var(--g);
    color: var(--s);
  }

  .pal-eyebrow {
    display: block;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    opacity: 0.8;
  }

  .pal-h {
    margin: var(--space-2xs) 0 var(--space-s);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .pal-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-btn);
    background-color: var(--a);
    color: var(--on-a);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .pal-body {
    padding: var(--space-m);
    background-color: var(--s);
    color: var(--g);
  }

  .pal-stat {
    margin: 0;
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .pal-copy {
    margin: var(--space-s) 0 var(--space-m);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--q);
  }

  .pal-copy a {
    color: var(--at);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-weight: 600;
  }

  .pal-tile {
    padding: var(--space-s);
    border-radius: var(--radius-panel);
    background-color: var(--s2);
  }

  .pal-tile-amt {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .pal-tile-name {
    margin: 0.15rem 0 0;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--q);
  }

  /* --- type ----------------------------------------------------------- */

  .type-row {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-xl);
    padding-block: var(--space-l);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  @media (max-width: 60rem) {
    .mark-row,
    .type-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .type-meta h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-lg);
  }

  .type-meta p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .type-h {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .type-b {
    margin: var(--space-s) 0 0;
    max-inline-size: var(--width-text);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  /* --- signature rule -------------------------------------------------- */

  .rule-old,
  .rule-new {
    display: block;
    inline-size: min(100%, 26rem);
    block-size: 3px;
    border-radius: 2px;
  }

  .rule-old {
    background-image: repeating-linear-gradient(
      to right,
      var(--color-amber) 0 18px,
      transparent 18px 30px
    );
  }

  /* Thickens as it approaches: the perspective logic without the highway. */
  .rule-new {
    block-size: 4px;
    background-color: var(--color-asphalt);
    clip-path: polygon(0 42%, 100% 0, 100% 100%, 0 58%);
  }

  .x-foot {
    padding-block: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--fg-quiet);
  }

  .x-foot p {
    margin: 0;
  }
</style>
