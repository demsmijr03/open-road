---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import DistanceStat from '../components/DistanceStat.astro';
import CtaBand from '../components/CtaBand.astro';
import AnimatedHeadline from '../components/AnimatedHeadline.astro';
import heroPhoto from '../assets/landingpage.png';
---

<BaseLayout
  heroOverlay
  title="Some roads are worth leaving home for | The Open Road Foundation"
  description="We help West Chester Area School District students afford the school that fits them best, wherever it takes them."
>
  <!-- Hero -------------------------------------------------------------
       A full-bleed photograph with the header floating on it. The copy is
       left-aligned over the darker left third of the image rather than centred,
       which is what lets the scrim be lighter than it was and the car stay
       visible. -->
  <section class="hero surface-deep">
    <div class="hero-media">
      <Image
        src={heroPhoto}
        alt="A hatchback packed with boxes, a lamp and a potted plant, parked in a driveway before the drive to school."
        widths={[800, 1200, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="wrap">
      <div class="hero-content">
      <span class="eyebrow rise" style="--rise-delay:100ms">West Chester, Pennsylvania</span>

      <div class="rise" style="--rise-delay:200ms">
        <AnimatedHeadline
          lead="We fund one student a year to go find"
          words={['perspective', 'opportunity', 'a wider view', 'their footing']}
        />
      </div>

      <p class="hero-lede rise" style="--rise-delay:330ms">
        The Open Road Foundation helps West Chester Area School District students afford the school
        that fits them best, wherever it takes them.
      </p>

      <div class="hero-actions rise" style="--rise-delay:440ms">
        <Button href="/get-involved/#give">Support a student</Button>
        <Button href="/about/" variant="secondary">Read our story</Button>
      </div>
      </div>
    </div>

  </section>

  <!-- One fact, the local one --------------------------------------------
       This was three stats stacked. Statistics dampen giving relative to an
       identifiable person, and response can fall as numbers accumulate, so a
       wall of figures this early was working against the page. The national and
       state context moved to About, where a reader who wants the wider case is
       already looking.

       This is the one that stops a West Chester donor: an affluent district
       where the need is real and invisible. When a student is funded, their
       story leads here and this becomes supporting. -->
  <section class="section--major surface-base">
    <div class="wrap">
      <div class="split">
        <h2 class="reveal">The need here is easy to miss.</h2>
        <div class="reveal" style="--reveal-delay:120ms">
          <DistanceStat
            scope="Here, in this district"
            figure="1 in 8"
            source="U.S. Census ACS 2024; NCES Common Core of Data, 2024–25."
          >
            <p>
              Median household income in the West Chester Area School District is $137,133. That is
              exactly why the need goes unseen. About one in eight of the district's 12,042 students
              is economically disadvantaged.
            </p>
          </DistanceStat>
        </div>
      </div>
    </div>
  </section>

  <!-- One idea, at size. This was a flat prose block, which is the wrong
       treatment for the single sentence the whole foundation rests on. -->
  <section class="section--major surface-panel">
    <div class="wrap">
      <div class="statement">
        <h2 class="statement-h reveal">Some roads are worth leaving home for.</h2>
        <p class="statement-p">
          We're a scholarship fund in West Chester. We raise money from people who live here and put
          it toward the cost of college for a student who has been accepted somewhere they can't
          quite afford. <a href="/about/">Read the full mission</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand heading="Open the road, and see what comes back.">
    <p slot="body">One student, this year. That's the whole goal, and it's reachable.</p>
    <Button href="/get-involved/#give">Support a student</Button>
    <a href="/get-involved/#newsletter">Or just get the newsletter</a>
  </CtaBand>
</BaseLayout>

<style>
  .statement {
    max-inline-size: var(--width-wide);
  }

  .statement-h {
    margin: 0;
    font-size: clamp(1.875rem, 4.4vw, 3rem);
    line-height: 1.14;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .statement-p {
    margin: var(--space-l) 0 0;
    max-inline-size: var(--width-text);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .statement-p a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--rule-strong);
    white-space: nowrap;
  }

  .statement-p a:hover {
    text-decoration-color: var(--fg);
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-content: center;
    /* Fills the viewport. The previous min(88vh, 46rem) capped the photograph
       at 736px, so on a laptop it stopped short of the fold and left a band of
       white beneath it. Content stays centred, so the section still grows past
       the viewport if the copy ever needs more room than that. */
    min-block-size: 100vh;
    /* svh excludes mobile browser chrome, which vh does not, so the hero is not
       taller than the visible area on a phone. */
    min-block-size: 100svh;
    /* Extra top padding clears the floating header. */
    padding-block: calc(var(--pad-major) + 3rem) var(--pad-major);
  }

  /* The header floats over this photograph and is at its tallest on the
     narrowest screens, where the viewport is also shortest. Those two work
     against each other, and at 360x780 the eyebrow ended up 5px above the
     header's bottom rule rather than below it. More top padding here is the
     floor that stops it happening again. */
  @media (max-width: 62rem) {
    .hero {
      padding-block-start: calc(var(--pad-major) + 7rem);
    }
    /* Full bleed: the photograph runs to the top and both edges rather than
       sitting inset as a panel. */
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* The subject sits low in the frame, so the crop favours the lower half
       and the sky is what gets cut on short viewports. */
    object-position: 50% 62%;
    /* Pulled off full saturation so the scrim reads as dusk rather than as a
       blue filter laid over a bright summer photograph. */
    filter: saturate(0.85);
  }

  /* The treatment.

     This photograph is bright: the sky behind the centred text sits around
     1.7:1 against paper, which is unreadable. A light scrim was not close, so
     these layers take the centre to roughly 85% of the deep teal, about 6:1.

     That is heavy, and deliberately so. The dark band was already the site's
     hero surface, and a deeply darkened photograph reads as that same band with
     a place inside it. The car, the porch and the tree line stay legible as
     shapes; the photograph is atmosphere, not a picture you study. */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Positive, not negative. .hero-media carries a negative z-index and so
       forms a stacking context; inside one, a negative-z child paints before
       the element's in-flow content, which put this scrim underneath the
       photograph and made it look like no treatment was applied at all. */
    z-index: 1;
    background:
      linear-gradient(
        to right,
        rgb(31 78 74 / 0.92),
        rgb(31 78 74 / 0.78) 42%,
        rgb(31 78 74 / 0.42) 100%
      ),
      linear-gradient(
        to bottom,
        rgb(31 78 74 / 0.55),
        rgb(31 78 74 / 0.35) 40%,
        rgb(31 78 74 / 0.6)
      );
  }

  /* Nested inside .wrap rather than being one. .wrap centres itself with
     margin-inline: auto, so capping its width directly pushed the copy into
     the middle of the photograph instead of holding it left. */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: start;
    max-inline-size: 40rem;
  }

  .hero h1 {
    margin: var(--space-s) 0 0;
    max-inline-size: 18ch;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .hero-lede {
    margin: var(--space-m) 0 0;
    max-inline-size: 30rem;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .hero-goal {
    margin: var(--space-s) 0 0;
    max-inline-size: 34rem;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }
</style>
