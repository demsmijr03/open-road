---
import { DONATE_URL } from '../consts';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import DistanceStat from '../components/DistanceStat.astro';
import CtaBand from '../components/CtaBand.astro';
import AnimatedHeadline from '../components/AnimatedHeadline.astro';
import heroPhoto from '../assets/landingpage.png';

const steps = [
  {
    title: 'You give',
    detail: 'Gifts, events and corporate match programs are the main way the fund grows.',
  },
  {
    title: 'We invest it',
    detail: 'In safe securities, such as government bonds, so every gift earns returns.',
  },
  {
    title: 'We award scholarships',
    detail: 'Together, gifts and returns fund scholarships for WCASD students each year.',
  },
];
---

<BaseLayout
  heroOverlay
  title="Some roads are worth leaving home for | The Open Road Foundation"
  description="We are building a community endowment for West Chester Area School District students. What we raise is invested to grow, and gifts and returns together fund scholarships every year."
>
  <!-- Hero -------------------------------------------------------------
       A full-bleed photograph with the header floating on it. The copy is
       left-aligned over the darker left third of the image rather than centred,
       which is what lets the scrim be lighter than it was and the car stay
       visible. -->
  <section class="hero surface-deep">
    <div class="hero-media">
      <Image
        src={heroPhoto}
        alt="A hatchback packed with boxes, a lamp and a potted plant, parked in a driveway before the drive to school."
        widths={[800, 1200, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="wrap">
      <div class="hero-content">
      <span class="eyebrow rise" style="--rise-delay:100ms">West Chester, Pennsylvania</span>

      <div class="rise" style="--rise-delay:200ms">
        <AnimatedHeadline
          lead="Every year, we fund students to discover"
          words={['perspective', 'opportunity', 'a wider view', 'what fits']}
        />
      </div>

      <p class="hero-lede rise" style="--rise-delay:330ms">
        The Open Road Foundation is building a community endowment for West Chester Area School
        District students. What we raise is invested to grow, and gifts and returns together fund
        scholarships every year.
      </p>

      <div class="hero-actions rise" style="--rise-delay:440ms">
        <Button href={DONATE_URL}>Support a student</Button>
        <Button href="/about/" variant="secondary">Read our story</Button>
      </div>
      </div>
    </div>

  </section>

  <!-- One idea, at size. This was a flat prose block, which is the wrong
       treatment for the single sentence the whole foundation rests on.

       It sits above the statistic as of August 2026. A reader was meeting "the
       need here is easy to miss" before being told what the foundation is, so
       the page argued before it introduced itself. -->
  <section class="section--major surface-panel">
    <div class="wrap">
      <div class="statement">
        <h2 class="statement-h reveal">Some roads are worth leaving home for.</h2>
        <p class="statement-p">
          We are a West Chester nonprofit, and the school district is our partner. The founders pay
          the running costs, so every gift goes into the fund.{' '}
          <a href="/about/">Read the full mission</a>
        </p>
      </div>

    </div>
  </section>

  <!-- One fact, the local one --------------------------------------------
       This was three stats stacked. Statistics dampen giving relative to an
       identifiable person, and response can fall as numbers accumulate, so a
       wall of figures this early was working against the page. The national and
       state context moved to About, and was removed from there on 24 Sep 2026:
       the endowment and the district partnership now carry the case.

       Stated as a count rather than as "1 in 8", which a donor could invert:
       seven in eight are fine, so why does my money matter. A count has no
       visible denominator to flip. The trade is that it is a bigger, more
       abstract number, which is the direction compassion-fade research says
       dampens giving, so it sits directly under the mission statement and ends
       on one student rather than on a population. See BRAND.md.

       When a student is funded, their story leads here and this becomes
       supporting. -->
  <section class="section--major surface-base">
    <div class="wrap">
      <div class="split">
        <h2 class="reveal">The need here is easy to miss.</h2>
        <div class="reveal" style="--reveal-delay:120ms">
          <DistanceStat
            scope="Here, in this district"
            figure="1,500"
            source="U.S. Census ACS 2024; NCES Common Core of Data, 2024–25."
          >
            <p>
              Median household income in the West Chester Area School District is $137,133. That is
              exactly why the need goes unseen. About 1,500 students in this district are
              economically disadvantaged. Our first scholarship goes to one of them this spring.
            </p>
          </DistanceStat>
        </div>
      </div>
    </div>
  </section>

  <!-- The endowment, as the three steps it actually is. Numbered because
       the order is the mechanism: a gift goes in, it is invested and earns, and
       gifts and returns together pay for scholarships.

       Its own section, placed directly before the closing ask, so the page
       runs who we are, why it matters, how your money works, then give.

       Drawn in the timeline's language, a ring per step joined by a hairline.
       On a wide screen each step is a centred column of one shared width, the
       ring over the middle of its text. The last ring is filled: it is the step
       the other two exist for. -->
  <section class="section surface-panel">
    <div class="wrap">
      <h2 class="how-title reveal">How the fund works</h2>
      <div class="how">
        <ol class="steps">
          {
            steps.map((step, i) => (
              <li
                class:list={['step', 'reveal', i === steps.length - 1 && 'step--last']}
                style={`--reveal-delay:${i * 110}ms`}
              >
                <span class="step-mark" aria-hidden="true">{i + 1}</span>
                <div class="step-body">
                  <p class="step-t">{step.title}</p>
                  <p class="step-d">{step.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <CtaBand heading="Open the road, and see what comes back.">
    <p slot="body">A gift here grows with the fund, and helps pay for scholarships this year and every year after.</p>
    <Button href={DONATE_URL}>Support a student</Button>
    <a href="/get-involved/#interest">Or just get the newsletter</a>
  </CtaBand>
</BaseLayout>

<style>
  .statement {
    max-inline-size: var(--width-wide);
  }

  .statement-h {
    margin: 0;
    font-size: clamp(1.875rem, 4.4vw, 3rem);
    line-height: 1.14;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .statement-p {
    margin: var(--space-l) 0 0;
    max-inline-size: var(--width-text);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .statement-p a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--rule-strong);
    white-space: nowrap;
  }

  .statement-p a:hover {
    text-decoration-color: var(--fg);
  }

  /* How the fund works ---------------------------------------------------- */

  .how-title {
    margin: 0 0 var(--space-l);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  .how {
    --mark: 2.75rem;
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-panel);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-elevated);
  }

  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: var(--mark) minmax(0, 1fr);
    gap: var(--space-s);
    align-items: start;
    /* The row stretches every step to the tallest one. Without this, a
       shorter step spread the spare height across its own rows and its title
       dropped below its neighbours'. */
    align-content: start;
  }

  /* The ring. Sits above the connector, so the hairline appears to run into
     it rather than through it. */
  .step-mark {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: var(--mark);
    block-size: var(--mark);
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
    background-color: var(--color-surface);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1;
    color: var(--accent-text);
  }

  /* The outcome, filled. Apricot carries no text, so the numeral takes the
     dark label colour made for the fill (6.02:1). */
  .step--last .step-mark {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* Connector, vertical on a phone: from under this ring to the next one. */
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(var(--mark) / 2 - 0.5px);
    inset-block: var(--mark) calc(var(--space-l) * -1);
    inline-size: 1px;
    background-color: var(--rule-strong);
  }

  .step-body p {
    margin: 0;
  }

  .step-body .step-t {
    padding-block-start: 0.55rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.25;
  }

  .step-body .step-d {
    margin-block-start: var(--space-2xs);
    max-inline-size: 22rem;
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  /* Side by side: each step is a centred column. The text block is one shared
     width in all three, and the ring sits over its middle. The connector runs
     ring centre to ring centre: from this ring's right edge (50% plus half a
     ring) to the next ring's left edge (the next column's middle, reached by
     going past this column's right edge by the gap plus half a column). */
  @media (min-width: 52rem) {
    .how {
      padding: var(--space-xl);
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl);
    }

    .step {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: var(--space-m);
      text-align: center;
    }

    .step-body {
      inline-size: min(100%, 17rem);
    }

    .step:not(:last-child)::before {
      inset-block: calc(var(--mark) / 2 - 0.5px) auto;
      inset-inline: calc(50% + var(--mark) / 2) calc(-50% - var(--space-xl) + var(--mark) / 2);
      inline-size: auto;
      block-size: 1px;
    }

    .step-body .step-t {
      padding-block-start: 0;
    }

    .step-body .step-d {
      max-inline-size: none;
    }
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-content: center;
    /* Fills the viewport. The previous min(88vh, 46rem) capped the photograph
       at 736px, so on a laptop it stopped short of the fold and left a band of
       white beneath it. Content stays centred, so the section still grows past
       the viewport if the copy ever needs more room than that. */
    min-block-size: 100vh;
    /* svh excludes mobile browser chrome, which vh does not, so the hero is not
       taller than the visible area on a phone. */
    min-block-size: 100svh;
    /* Extra top padding clears the floating header. */
    padding-block: calc(var(--pad-major) + 3rem) var(--pad-major);
  }

  /* The header floats over this photograph and is at its tallest on the
     narrowest screens, where the viewport is also shortest. Those two work
     against each other, and at 360x780 the eyebrow ended up 5px above the
     header's bottom rule rather than below it. More top padding here is the
     floor that stops it happening again. */
  @media (max-width: 62rem) {
    .hero {
      padding-block-start: calc(var(--pad-major) + 7rem);
    }
    /* Full bleed: the photograph runs to the top and both edges rather than
       sitting inset as a panel. */
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* The subject sits low in the frame, so the crop favours the lower half
       and the sky is what gets cut on short viewports. */
    object-position: 50% 62%;
    /* Pulled off full saturation so the scrim reads as dusk rather than as a
       blue filter laid over a bright summer photograph. */
    filter: saturate(0.85);
  }

  /* The treatment.

     This photograph is bright: the sky behind the centred text sits around
     1.7:1 against paper, which is unreadable. A light scrim was not close, so
     these layers take the centre to roughly 85% of the deep teal, about 6:1.

     That is heavy, and deliberately so. The dark band was already the site's
     hero surface, and a deeply darkened photograph reads as that same band with
     a place inside it. The car, the porch and the tree line stay legible as
     shapes; the photograph is atmosphere, not a picture you study. */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Positive, not negative. .hero-media carries a negative z-index and so
       forms a stacking context; inside one, a negative-z child paints before
       the element's in-flow content, which put this scrim underneath the
       photograph and made it look like no treatment was applied at all. */
    z-index: 1;
    background:
      linear-gradient(
        to right,
        rgb(31 78 74 / 0.92),
        rgb(31 78 74 / 0.78) 42%,
        rgb(31 78 74 / 0.42) 100%
      ),
      linear-gradient(
        to bottom,
        rgb(31 78 74 / 0.55),
        rgb(31 78 74 / 0.35) 40%,
        rgb(31 78 74 / 0.6)
      );
  }

  /* Nested inside .wrap rather than being one. .wrap centres itself with
     margin-inline: auto, so capping its width directly pushed the copy into
     the middle of the photograph instead of holding it left. */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: start;
    max-inline-size: 40rem;
  }

  .hero h1 {
    margin: var(--space-s) 0 0;
    max-inline-size: 18ch;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .hero-lede {
    margin: var(--space-m) 0 0;
    max-inline-size: 30rem;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .hero-goal {
    margin: var(--space-s) 0 0;
    max-inline-size: 34rem;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }
</style>
