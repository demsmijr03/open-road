---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Placeholder from '../components/Placeholder.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import DistanceStat from '../components/DistanceStat.astro';
import townPhoto from '../assets/westchester.jpg';

/**
 * Founder photographs.
 *
 * Astro's <Image /> needs a real import, and a missing file is a build error
 * rather than a broken image, so each headshot is imported through a glob and
 * looked up by slug. A founder with no file on disk keeps the visible
 * placeholder instead, which is the same rule the rest of the site follows.
 */
const headshots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/founders/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const photoFor = (slug: string) =>
  Object.entries(headshots).find(([path]) => path.includes(`/${slug}.`))?.[1].default;

/**
 * Bios run short on purpose: five of them sit side by side, so anything longer
 * turns the row into a wall. Two or three sentences each, and the openings are
 * varied deliberately. Four of the five left the same high school, and writing
 * that fact the same way five times makes the row read as a template.
 */
const board = [
  {
    slug: 'joe-clark',
    name: 'Joe Clark',
    role: 'President',
    bio: 'West Chester East, then the University of Alabama for math, finance, and economics. Now an associate at BCG.',
  },
  {
    slug: 'riley-boutin',
    name: 'Riley Boutin',
    role: 'Treasurer',
    bio: 'Connecticut to West Chester to Auburn University, for finance, picked because it was unfamiliar. Now in wealth management in Tampa.',
  },
  {
    slug: 'niko-levin',
    name: 'Niko Levin',
    role: 'VP, Outreach',
    bio: 'The University of Miami by way of West Chester East. Now an analyst at Accenture in Philadelphia, the closest of the five to home.',
  },
  {
    slug: 'jackson-kulp',
    name: 'Jackson Kulp',
    role: 'VP, Development',
    bio: 'Abilene Christian University after West Chester East. Now a doctorate in physical therapy at the University of Pittsburgh.',
  },
  {
    slug: 'demetrius-smith',
    name: 'Demetrius Smith Jr.',
    role: 'VP, Marketing',
    bio: 'The Ohio State University, chosen to see somewhere he had never been. Now an analyst at Accenture in New York.',
  },
];
---

<BaseLayout
  title="About us | The Open Road Foundation"
  description="Five people who grew up in West Chester and left for school. Why we started The Open Road Foundation, and who is accountable for it."
>
  <PageHero
    heading="About us"
    lede="Five people who grew up in West Chester and left for school. Some of us came back. All of us are still here in the ways that count."
  />

  <!-- Sits flush under the masthead, edge to edge, so the two read as one unit
       and the page opens on the place rather than on a slab of text.

       Full width and uncropped rather than used as a hero background: the source
       is a 3.5:1 panorama, and cropping it to a phone-shaped hero would reduce
       it to an unreadable slice of rooftops.

       The five-founders group shot this replaced was dropped because five real
       headshots already do that job, and with the founders in five cities a
       group photo would have held the page indefinitely. -->
  <section class="town-band surface-base">
    <figure class="town">
      <Image
        src={townPhoto}
        alt="West Chester, Pennsylvania at sunset, looking across the rooftops of High Street toward the courthouse clock tower."
        widths={[800, 1200, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="wrap">
        West Chester, Pennsylvania. Where all five of us grew up, and the place we each left for school.
      </figcaption>
    </figure>
  </section>

  <section class="section surface-base" id="why">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">Why we started this</h2>
        <p>
          The five of us grew up here. We went to different places for school, studied different
          things and ended up in different cities, but the same thing happened to each of us: the
          education we got changed what we thought was possible for ourselves.
        </p>
        <!-- Reframed August 2026. This used to read "what we found out there was
             perspective", which put the value in the leaving. Most of the people
             we are asking to fund this did not leave, and a line saying
             perspective is what you get by going away tells them, quietly, that
             they lack it. The value is in the education. West Chester is the
             reason any of us could go after it. -->
        <p class="pull">That is what we want to hand to somebody else.</p>
        <p>
          None of it started with us. It started here, with the teachers, the coaches, the families
          and the neighbors who made it normal to aim at something. Some of us came back to Chester
          County and some of us did not. All five of us know where it came from.
        </p>
        <p>
          There are students here right now who want that same education and cannot have it, for one
          reason: money. That is the only thing standing between them and it. So we are removing it.
        </p>
        <p>
          Whether they come back is not the test. If West Chester is the kind of place that sends
          its students after what they want, that is worth something to West Chester, wherever they
          end up.
        </p>
      </div>
    </div>
  </section>

  <!-- The wider case, moved off the home page. Three statistics stacked at the
       top of a donation funnel work against it; here, a reader who wants the
       context has come looking for it. The home page keeps the local fact. -->
  <section class="section surface-panel">
    <div class="wrap">
      <div class="split">
        <h2 class="reveal">It isn't only here.</h2>

        <div class="context-stats">
          <div class="reveal">
            <DistanceStat
              scale="inline"
              scope="Nationally"
              figure="35%"
              source="National College Attainment Network, September 2025."
            >
              <p>
                Only about a third of public four-year colleges are affordable to a student from a
                low-income family. For families in the lowest income quarter, the price after aid
                eats close to 90% of what they earn in a year.
              </p>
            </DistanceStat>
          </div>

          <div class="reveal" style="--reveal-delay:120ms">
            <DistanceStat
              scale="inline"
              scope="In Pennsylvania"
              figure="29%"
              source="Education Data Initiative, 2025–26."
            >
              <p>
                Pennsylvania's in-state tuition at public four-year universities runs 29% above the
                national average, at $17,909 a year. Staying close to home is not the discount
                people assume it is.
              </p>
            </DistanceStat>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- On the .split spine, like every other text section. This was a 34rem
       quote inside a 46rem column on a 72rem page: three nested width caps,
       which left most of the section empty. -->
  <!-- The dark band. It moved here when the "why fund a student to leave"
       section was removed, which otherwise left two panel surfaces adjacent and
       the page with no deep band at all. The mission is the right thing to
       carry it. -->
  <section class="section--major surface-deep">
    <div class="wrap">
      <div class="split">
        <h2 class="mission-title reveal">Our mission</h2>
        <blockquote class="mission reveal">
          The Open Road Foundation exists to uplift Philadelphia Area students pursuing a college
          degree through financial support and mentorship, offering greater educational
          opportunities and a chance to explore their passions in the settings that will help them
          flourish.
        </blockquote>
        <p class="mission-note">
          One note on that, in plainer words: <strong
            >every award we make today goes to a West Chester Area School District student.</strong
          > "Philadelphia Area" is where we are going, not where we are.
        </p>
      </div>
    </div>
  </section>

  <section class="section surface-base">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">Who's accountable</h2>
        <p>Five people, named, with our roles. You can write to any of us directly.</p>
      </div>

      <ul class="board">
        {
          board.map((person, i) => {
            const photo = photoFor(person.slug);
            return (
              <li class="board-member reveal" style={`--reveal-delay:${i * 95}ms`}>
                <div class="board-portrait">
                  {photo ? (
                    <Image
                      src={photo}
                      alt={`${person.name}, ${person.role}`}
                      width={480}
                      widths={[240, 480]}
                      sizes="(max-width: 60rem) 45vw, 15rem"
                    />
                  ) : (
                    <Placeholder note={`headshot for ${person.name}`} />
                  )}
                </div>
                <p class="board-name">{person.name}</p>
                <p class="board-role">{person.role}</p>
                <p class="board-bio">{person.bio}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <CtaBand heading="One student, by the end of this school year.">
    <p slot="body">
      We're raising the first award now. It goes to one WCASD student by the end of the school year.
    </p>
    <Button href="/get-involved/#give">Support a student</Button>
  </CtaBand>
</BaseLayout>

<style>
  /* Two facts side by side on a wide screen, stacked below. They sit in the
     .split right column, which caps at --width-text, so the pair needs the cap
     lifted to breathe. */
  .split > .context-stats {
    max-inline-size: none;
  }

  .context-stats {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }

  @media (min-width: 52rem) {
    .context-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* A pull quote, not a heading: it is the sentence the page turns on, so it
     gets display size without taking a level in the outline. */
  .pull {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.125rem);
    line-height: 1.22;
    letter-spacing: var(--tracking-display);
    color: var(--fg);
    text-wrap: balance;
  }

  /* No top padding: the band butts against the masthead with no seam. */
  .town-band {
    padding-block: 0 var(--space-m);
  }

  .town {
    margin: 0;
  }

  .town :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* At 390px the native 3.5:1 leaves a 111px ribbon, too thin to register as a
     photograph. Below 40rem it takes a 2:1 box and covers, trimming width
     rather than height so the buildings stay large enough to read. Wider
     screens keep the full uncropped sweep. */
  @media (max-width: 40rem) {
    .town :global(img) {
      aspect-ratio: 2 / 1;
      block-size: auto;
      object-fit: cover;
      object-position: 50% 50%;
    }
  }

  .town figcaption {
    margin-block-start: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--fg-quiet);
  }

  .mission-title {
    margin: 0 0 var(--space-m);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  /* Set large and given room, with no rule down the side. The size and the
     display face are enough to mark it as the quoted mission. */
  /* .split caps its right column at --width-text (38rem), which is the right
     measure for body copy but too narrow for a display-size quote. These two
     take the full column instead: at ~1.875rem the line still lands near 60
     characters, so the measure holds. */
  .split > .mission,
  .split > .mission-note {
    max-inline-size: none;
  }

  .mission {
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .mission-note {
    margin: var(--space-m) 0 0;
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-l);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  /* There are exactly five founders. auto-fit lands on four columns at this
     width and orphans the fifth on its own row, so the wide layout is pinned to
     five and the gap tightened to make them fit. */
  @media (min-width: 64rem) {
    .board {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-m);
    }
  }

  .board-member {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .board-portrait {
    aspect-ratio: 1;
    margin-block-end: var(--space-2xs);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  /* Deliberately not `align-content: center` here. That sizes the grid row to
     its content, which leaves the image's block-size: 100% resolving against an
     indefinite height, collapsing it to zero and rendering an empty square.
     Centring belongs to the empty state only, below. */
  /* The square frame is cut here, not at build time. <Image> above
     deliberately sets no `height`: forcing 480x480 made sharp centre-crop any
     non-square source before the browser ever saw it, which took the top of
     Jackson's head off and left this rule with no slack to work in. Four of
     the five sources are already square, so this only bites on his.

     15% rather than centre: it holds the whole head with air above it and
     spends the difference on chest, which is the half of a headshot nobody
     needs to see. */
  .board-portrait :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }

  /* Only the empty state carries the dashed outline. Once a real photograph
     lands the frame gets out of its way. */
  .board-portrait:has(.ph-block) {
    display: grid;
    align-content: center;
    padding: var(--space-2xs);
    border: var(--border-hairline) dashed var(--rule-strong);
    overflow: visible;
  }

  .board-bio {
    margin: var(--space-2xs) 0 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .board-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .board-role {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--fg-quiet);
  }

</style>
