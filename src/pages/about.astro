---
import { DONATE_URL } from '../consts';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Placeholder from '../components/Placeholder.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import townPhoto from '../assets/westchester.jpg';

/**
 * Founder photographs.
 *
 * Astro's <Image /> needs a real import, and a missing file is a build error
 * rather than a broken image, so each headshot is imported through a glob and
 * looked up by slug. A founder with no file on disk keeps the visible
 * placeholder instead, which is the same rule the rest of the site follows.
 */
const headshots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/founders/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const photoFor = (slug: string) =>
  Object.entries(headshots).find(([path]) => path.includes(`/${slug}.`))?.[1].default;

/**
 * Bios run short on purpose: five of them sit side by side, so anything longer
 * turns the row into a wall. Two or three sentences each, and the openings are
 * varied deliberately. Four of the five left the same high school, and writing
 * that fact the same way five times makes the row read as a template.
 */
const board = [
  {
    slug: 'joe-clark',
    name: 'Joe Clark',
    role: 'President',
    bio: 'West Chester East, then the University of Alabama for math, finance, and economics. Now an associate at BCG.',
  },
  {
    slug: 'riley-boutin',
    name: 'Riley Boutin',
    role: 'Treasurer',
    bio: 'Connecticut to West Chester to Auburn University, for finance, picked because it was unfamiliar. Now in wealth management in Tampa.',
  },
  {
    slug: 'niko-levin',
    name: 'Niko Levin',
    role: 'VP, Outreach',
    bio: 'The University of Miami by way of West Chester East. Now an analyst at Accenture in Philadelphia, the closest of the five to home.',
  },
  {
    slug: 'jackson-kulp',
    name: 'Jackson Kulp',
    role: 'VP, Development',
    bio: 'Abilene Christian University after West Chester East. Now a doctorate in physical therapy at the University of Pittsburgh.',
  },
  {
    slug: 'demetrius-smith',
    name: 'Demetrius Smith Jr.',
    role: 'VP, Marketing',
    bio: 'The Ohio State University, chosen to see somewhere he had never been. Now an analyst at Accenture in New York.',
  },
];
/* Where we stand. The facts are the FAQ's; each is set in the shape it has. */
const checks = ['Registered 501(c)(3)', 'Approved in Pennsylvania', 'Articles of incorporation'];

const commitments = [
  'Sponsoring district-wide and school-specific events',
  'Promoting our scholarship in its schools',
  'Sharing input on the students who apply',
  'Marketing Open Road as an official district-wide scholarship partner',
];

const milestones = [
  { figure: '$10,000', label: "This year's goal" },
  { figure: '$25,000', label: 'As partners join' },
  { figure: '$50,000', label: 'With sponsors' },
  { figure: 'Six figures', label: 'The long run' },
];
---

<BaseLayout
  title="About us | The Open Road Foundation"
  description="Five people who grew up in West Chester. What this place gave us, why we started The Open Road Foundation, and who is accountable for it."
>
  <PageHero
    heading="About us"
    lede="Five people who grew up in West Chester. What this place gave us, and what we are giving back."
  />

  <!-- Sits flush under the masthead, edge to edge, so the two read as one unit
       and the page opens on the place rather than on a slab of text.

       Full width and uncropped rather than used as a hero background: the source
       is a 3.5:1 panorama, and cropping it to a phone-shaped hero would reduce
       it to an unreadable slice of rooftops.

       The five-founders group shot this replaced was dropped because five real
       headshots already do that job, and with the founders in five cities a
       group photo would have held the page indefinitely. -->
  <section class="town-band surface-base">
    <figure class="town">
      <Image
        src={townPhoto}
        alt="West Chester, Pennsylvania at sunset, looking across the rooftops of High Street toward the courthouse clock tower."
        widths={[800, 1200, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="wrap">
        West Chester, Pennsylvania. Where all five of us grew up, and the reason we could go after what we wanted.
      </figcaption>
    </figure>
  </section>

  <section class="section surface-base" id="why">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">Why we started this</h2>
        <p>
          The five of us grew up here. We went to different places for school, studied different
          things and ended up in different cities, but the same thing happened to each of us: the
          education we got changed what we thought was possible for ourselves.
        </p>
        <!-- Reframed August 2026. This used to read "what we found out there was
             perspective", which put the value in the leaving. Most of the people
             we are asking to fund this did not leave, and a line saying
             perspective is what you get by going away tells them, quietly, that
             they lack it. The value is in the education. West Chester is the
             reason any of us could go after it. -->
        <p class="pull">That is what we want to hand to somebody else.</p>
        <p>
          None of it started with us. It started here, with the teachers, the coaches, the families
          and the neighbors who made it normal to aim at something. Some of us came back to Chester
          County and some of us did not. All five of us know where it came from.
        </p>
        <p>
          There are students here right now who want that same education and cannot have it, for one
          reason: money. That is the only thing standing between them and it. So we are removing it.
        </p>
        <p>
          What matters is that they get to go. If West Chester is the kind of place that sends
          its students after what they want, that is worth something to West Chester, wherever they
          end up.
        </p>
      </div>
    </div>
  </section>


  <!-- On the .split spine, like every other text section. This was a 34rem
       quote inside a 46rem column on a 72rem page: three nested width caps,
       which left most of the section empty. -->
  <!-- The dark band. It moved here when the "why fund a student to leave"
       section was removed, which otherwise left two panel surfaces adjacent and
       the page with no deep band at all. The mission is the right thing to
       carry it. -->
  <section class="section--major surface-deep">
    <div class="wrap">
      <div class="split">
        <h2 class="mission-title reveal">Our mission</h2>
        <blockquote class="mission reveal">
          The Open Road Foundation exists to uplift Philadelphia Area students pursuing a college
          degree through financial support and mentorship, offering greater educational
          opportunities and a chance to explore their passions in the settings that will help them
          flourish.
        </blockquote>
        <p class="mission-note">
          One note on that, in plainer words: <strong
            >every award we make today goes to a West Chester Area School District student.</strong
          > "Philadelphia Area" is where we are going, not where we are.
        </p>
      </div>
    </div>
  </section>

  <!-- The FAQ's standing facts, each in the form it actually has.
       Registration is a set of checks, so it reads as checks. The district's
       commitments are four parallel things, so they sit as four equal cards,
       the way the tiers do. The goals are a sequence, so they sit on a track
       drawn in the timeline's language: a dot per milestone and a hairline
       between them, the first filled because it is this year's. -->
    <section class="section surface-panel" id="where-we-stand">
    <div class="wrap">
      <div class="split stand-split">
        <h2 class="reveal">Where we stand</h2>

        <div class="stand">
          <ul class="checks">
            {checks.map((c) => <li>{c}</li>)}
          </ul>
          <p class="stand-p">
            We have completed every Pennsylvania requirement for a new nonprofit, and we are ready
            to operate as a 501(c)(3) partner.
          </p>
        </div>

        <div class="stand">
          <h3 class="stand-h">Our partnership with WCASD</h3>
          <p class="stand-p">The school district has agreed to partner with us on four fronts.</p>
          <ul class="commits">
            {commitments.map((c) => <li>{c}</li>)}
          </ul>
        </div>

        <div class="stand">
          <h3 class="stand-h">Where this is going</h3>
          <ol class="track" aria-label="Milestones for the fund">
            {
              milestones.map((m, i) => (
                <li class:list={['track-stop', i === 0 && 'track-stop--now']}>
                  <span class="track-dot" aria-hidden="true" />
                  <span class="track-figure">{m.figure}</span>
                  <span class="track-label">{m.label}</span>
                </li>
              ))
            }
          </ol>
                    <p class="stand-p">
            Ultimately, we could see this becoming hundreds of thousands of dollars as a community
            endowment, generating thousands a year for scholarships. We plan year by year and review
            our goals annually. Over time, corporate sponsorships and partnerships will carry the
            fund from one milestone to the next.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-base">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">The five of us</h2>
        <p>
          Five people, named, with our roles. Write to any of us at our shared inbox,{' '}
          <a href="mailto:openroadfdn.admin@gmail.com">openroadfdn.admin@gmail.com</a>.
        </p>
      </div>

      <ul class="board">
        {
          board.map((person, i) => {
            const photo = photoFor(person.slug);
            return (
              <li class="board-member reveal" style={`--reveal-delay:${i * 95}ms`}>
                <div class="board-portrait">
                  {photo ? (
                    <Image
                      src={photo}
                      alt={`${person.name}, ${person.role}`}
                      width={480}
                      widths={[240, 480]}
                      sizes="(max-width: 60rem) 45vw, 15rem"
                    />
                  ) : (
                    <Placeholder note={`headshot for ${person.name}`} />
                  )}
                </div>
                <p class="board-name">{person.name}</p>
                <p class="board-role">{person.role}</p>
                <p class="board-bio">{person.bio}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <CtaBand heading="Our first scholarship, this May.">
    <p slot="body">
      We're building the fund now. Our first scholarship goes to a WCASD senior on May 1, and the fund keeps paying out every year after.
    </p>
    <Button href={DONATE_URL}>Support a student</Button>
  </CtaBand>
</BaseLayout>

<style>
  /* --- Where we stand --------------------------------------------------- */

  .stand {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .stand + .stand {
    padding-block-start: var(--space-l);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .stand-h {
    margin: 0;
    font-size: var(--text-xl);
  }

    /* One right edge for the whole column. The text used to stop at the
     narrower text measure, 128px short of the cards and track beside it, so
     the section read as unfinished. Now words, cards and track all end on the
     same line. */
  .stand-p {
    margin: 0;
    line-height: var(--leading-body);
    color: var(--fg-quiet);
    text-wrap: pretty;
  }

  /* Equal space above and below each divider: the grid's row gap matches the
     padding under the rule. */
  .stand-split {
    row-gap: var(--space-l);
  }

  .stand ul,
  .stand ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Registration, as checks. The tick is drawn in CSS, two borders of a
     rotated box, so it needs no icon and no emoji. */
  /* One row of three on a wide screen, so no check is left on a line of its
     own; stacked below that. */
  .checks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs) var(--space-m);
  }

    /* Spread edge to edge once the column can hold all three (about 700px), so
     the row starts and ends where the cards below do. Narrower, they stack:
     at 1024px the row was 37px wider than its column. */
  @media (min-width: 80rem) {
    .checks {
      grid-template-columns: repeat(3, max-content);
      justify-content: space-between;
      gap: var(--space-2xs) var(--space-l);
    }
  }

  .checks li {
    position: relative;
    padding-inline-start: 1.85rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--fg);
  }

  .checks li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 50%;
    inline-size: 1.3rem;
    block-size: 1.3rem;
    border-radius: 50%;
    background-color: var(--color-deep);
    transform: translateY(-50%);
  }

  .checks li::after {
    content: '';
    position: absolute;
    inset-inline-start: 0.47rem;
    inset-block-start: 50%;
    inline-size: 0.34rem;
    block-size: 0.62rem;
    border: solid var(--color-surface);
    border-width: 0 2px 2px 0;
    transform: translateY(-62%) rotate(45deg);
  }

  /* The four commitments: parallel, so equal cards, like the tiers. */
  .commits {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
  }

  @media (min-width: 40rem) {
    .commits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

    /* Balanced lines, so a two-line card splits evenly instead of breaking
     "school-specific" at its hyphen, and text centred in the card's height, so
     a one-line card sits as squarely as its two-line neighbours. */
  .commits li {
    display: flex;
    align-items: center;
    padding: var(--space-m);
    border-radius: var(--radius-panel);
    background-color: var(--color-surface);
    border: var(--border-hairline) solid var(--rule);
    line-height: 1.5;
    color: var(--fg);
    text-wrap: balance;
  }

  /* The milestones, on a track. Same dot and hairline as the year's timeline,
     laid horizontally, so the page's sequences share one visual language. */
  .track {
    --dot: 0.85rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-s);
    margin-block: var(--space-2xs) var(--space-2xs);
  }

  /* Each stop is a centred column: dot over the middle of its figure and
     label. The hairline runs dot centre to dot centre, from this dot's right
     edge to the next dot's left edge half a column and a gap along. */
  .track-stop {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    text-align: center;
  }

  .track-stop:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-block-start: calc(var(--dot) / 2 - 0.5px);
    inset-inline: calc(50% + var(--dot) / 2) calc(-50% - var(--space-s) + var(--dot) / 2);
    block-size: 1px;
    background-color: var(--rule-strong);
  }

  .track-dot {
    inline-size: var(--dot);
    block-size: var(--dot);
    margin-block-end: var(--space-2xs);
    border-radius: 50%;
    border: 1.5px solid var(--color-deep);
    background-color: var(--color-surface);
  }

  .track-stop--now .track-dot {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .track-figure {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .track-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  /* On a phone the four stops stack, with the hairline running down. */
  @media (max-width: 40rem) {
    .track {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-m);
    }

    .track-stop {
      align-items: flex-start;
      padding-inline-start: calc(var(--dot) + var(--space-s));
      text-align: start;
    }

    .track-dot {
      position: absolute;
      inset-inline-start: 0;
      inset-block-start: 0.35rem;
      margin: 0;
    }

    .track-stop:not(:last-child)::before {
      inset-block: calc(0.35rem + var(--dot)) calc(var(--space-m) * -1 + 0.35rem);
      inset-inline: calc(var(--dot) / 2 - 0.5px) auto;
      inline-size: 1px;
      block-size: auto;
    }
  }

  /* A pull quote, not a heading: it is the sentence the page turns on, so it
     gets display size without taking a level in the outline. */
  .pull {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.125rem);
    line-height: 1.22;
    letter-spacing: var(--tracking-display);
    color: var(--fg);
    text-wrap: balance;
  }

  /* No top padding: the band butts against the masthead with no seam. */
  .town-band {
    padding-block: 0 var(--space-m);
  }

  .town {
    margin: 0;
  }

  .town :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* At 390px the native 3.5:1 leaves a 111px ribbon, too thin to register as a
     photograph. Below 40rem it takes a 2:1 box and covers, trimming width
     rather than height so the buildings stay large enough to read. Wider
     screens keep the full uncropped sweep. */
  @media (max-width: 40rem) {
    .town :global(img) {
      aspect-ratio: 2 / 1;
      block-size: auto;
      object-fit: cover;
      object-position: 50% 50%;
    }
  }

  .town figcaption {
    margin-block-start: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--fg-quiet);
  }

  .mission-title {
    margin: 0 0 var(--space-m);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  /* Set large and given room, with no rule down the side. The size and the
     display face are enough to mark it as the quoted mission. */
  /* .split caps its right column at --width-text (38rem), which is the right
     measure for body copy but too narrow for a display-size quote. These two
     take the full column instead: at ~1.875rem the line still lands near 60
     characters, so the measure holds. */
  .split > .mission,
  .split > .mission-note {
    max-inline-size: none;
  }

  .mission {
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .mission-note {
    margin: var(--space-m) 0 0;
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-l);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  /* There are exactly five founders. auto-fit lands on four columns at this
     width and orphans the fifth on its own row, so the wide layout is pinned to
     five and the gap tightened to make them fit. */
  @media (min-width: 64rem) {
    .board {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-m);
    }
  }

  .board-member {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .board-portrait {
    aspect-ratio: 1;
    margin-block-end: var(--space-2xs);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  /* Deliberately not `align-content: center` here. That sizes the grid row to
     its content, which leaves the image's block-size: 100% resolving against an
     indefinite height, collapsing it to zero and rendering an empty square.
     Centring belongs to the empty state only, below. */
  /* The square frame is cut here, not at build time. <Image> above
     deliberately sets no `height`: forcing 480x480 made sharp centre-crop any
     non-square source before the browser ever saw it, which took the top of
     Jackson's head off and left this rule with no slack to work in. Four of
     the five sources are already square, so this only bites on his.

     15% rather than centre: it holds the whole head with air above it and
     spends the difference on chest, which is the half of a headshot nobody
     needs to see. */
  .board-portrait :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }

  /* Only the empty state carries the dashed outline. Once a real photograph
     lands the frame gets out of its way. */
  .board-portrait:has(.ph-block) {
    display: grid;
    align-content: center;
    padding: var(--space-2xs);
    border: var(--border-hairline) dashed var(--rule-strong);
    overflow: visible;
  }

  .board-bio {
    margin: var(--space-2xs) 0 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .board-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .board-role {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--fg-quiet);
  }

</style>
