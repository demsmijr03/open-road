---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';

const criteria = [
  { title: 'You go to a WCASD high school', detail: "You're graduating from a West Chester Area School District high school." },
  { title: 'A 3.25 GPA or above', detail: 'Measured on your school’s standard scale.' },
  { title: 'You have financial need', detail: 'How this is assessed is confirmed before the application opens.' },
  { title: 'You have an offer in hand', detail: "Accepted somewhere, or holding offers. No requirement about where you go or what kind of program it is." },
];

const faqs = [
  {
    q: 'Who can apply?',
    a: 'Any student graduating from a West Chester Area School District high school with a 3.25 GPA or above, financial need, and an offer or acceptance in hand.',
  },
  {
    q: 'How much is the award, and what can I spend it on?',
    a: 'One award, once, to one student. We are raising $10,000 this year and every dollar of it goes into the fund. The share that reaches this year’s student is confirmed before the application opens, so we are not putting a number on it yet.',
  },
  {
    q: 'Can I use it at an out-of-state school?',
    a: 'Yes. In state, out of state, public, private, four-year, two-year, or a trade program. The award goes where you go.',
  },
  {
    q: 'When can I apply?',
    a: "The application isn't open yet and the dates aren't set. Leave your email and we'll tell you the moment they are.",
  },
  {
    q: 'Who decides?',
    a: 'The district’s scholarship committee and the Open Road founders, reading together. Neither side picks alone.',
  },
];
---

<BaseLayout
  title="For students | The Open Road Foundation"
  description="Who can apply, what it covers, and how we choose. One award, for a West Chester Area School District student."
>
  <!-- The page opens on what the foundation does, not on the word "award".
       The standalone "What we do" section this replaced is gone: its wording
       is the masthead now.

       The figure is the fund, not the award. Every dollar raised goes into it,
       and the share that reaches this year's student is set before the
       application opens. Stating a number now would mean revising it later. -->
  <PageHero
    heading="We raise money here, and put it toward college"
    lede="Money from people who live in West Chester, for a student who has been accepted somewhere they can't quite afford. Here's who can apply, what it covers, and how we choose."
  >
    <div slot="aside" class="award-figure">
      <p class="award-amount">$10,000</p>
      <p class="award-caption">the year-one fund, every dollar of it.</p>
      <p class="award-footnote">
        <em>
          Running the foundation is paid for by the founders, so nothing comes out of this. The
          share that goes to this year's student is confirmed before the application opens.
        </em>
      </p>
    </div>
  </PageHero>

  <section class="section surface-panel">
    <div class="wrap">
      <h2 class="qual-title reveal">Who qualifies</h2>
      <!-- Four criteria, each independently checkable. A student scanning "do I
           qualify" is served better by four cards than by a bullet list, because
           each one either applies to them or does not. -->
      <ul class="quals">
        {
          criteria.map((c, i) => (
            <li class="qual reveal" style={`--reveal-delay:${i * 110}ms`}>
              <p class="qual-n">{String(i + 1).padStart(2, '0')}</p>
              <p class="qual-t">{c.title}</p>
              <p class="qual-d">{c.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section--major surface-base">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">What the award covers</h2>
        <p>
          It's yours to put toward the real cost of going: tuition, books, a laptop, the travel to
          get there. Anything that supports your time at the school you chose.
        </p>
        <p>
          We'll confirm how the money reaches you, whether that's paid to your school or to you
          directly, before the application opens.{' '}
          <a href="/get-involved/#plan">See the plan for the year.</a>
        </p>
      </div>

      <div class="split prose follows">
        <h3>It follows you wherever you go</h3>
        <p>
          In state or out of state. Public or private. A four-year school, a two-year school, or a
          trade program. If it's the right place for you, the award goes with you.
        </p>
        <p>
          We don't require you to stay in Pennsylvania, and we don't require you to come back.{' '}
          <a href="/about/#the-question">That's the whole point.</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section surface-panel">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">How we choose, and when</h2>
        <p>
          Two groups read applications together: the West Chester Area School District's scholarship
          committee and the founders of Open Road. Neither picks alone.
        </p>
        <p>
          We're looking for students who work hard and who want something specific, and who would be
          held back from it by money alone.
        </p>
        <p>
          Fundraising opens in September. The first award is made in April. We'll email you the
          application dates the moment they're set.
        </p>
      </div>
    </div>
  </section>

  <section class="section surface-base" id="questions">
    <div class="wrap">
      <div class="split faq-split">
        <h2 class="faq-title reveal">Questions</h2>
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <CtaBand heading="No application yet, and no deadline to miss.">
    <p slot="body">Leave your name and we'll write to you the day it opens.</p>
    <Button href="/get-involved/#interest">Tell us you're interested</Button>
  </CtaBand>
</BaseLayout>

<style>
  /* The accordion fills its column: .split caps children at --width-text, which
     squeezes FAQ rows that already wrap. */
  .faq-split > :not(h2, h3) {
    max-inline-size: none;
  }

  .faq-title {
    margin-block: 0;
  }

  .qual-title {
    margin: 0 0 var(--space-l);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  .quals {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .quals { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .quals { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .qual {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-m);
    border-radius: var(--radius-panel);
    background-color: var(--color-surface);
    border: var(--border-hairline) solid var(--rule);
  }

  /* Numbered because eligibility is a checklist, not a ranking: the numerals
     help a student keep their place across four cards. */
  .qual-n {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--fg-quiet);
  }

  .qual-t {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
  }

  .qual-d {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .checklist {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .checklist li {
    position: relative;
    padding-inline-start: var(--space-m);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  /* A plain round marker. The lane dash that used to sit here was the road
     motif doing a list's work, and a list does not need a motif. */
  .checklist li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.2rem;
    inset-block-start: 0.72em;
    inline-size: 0.3rem;
    block-size: 0.3rem;
    border-radius: 50%;
    background-color: var(--fg-quiet);
  }

  /* The figure, now in the masthead. Sized a little under the old in-page
     version so it sits beside the h1 rather than competing with it. */
  .award-amount {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: var(--tracking-display);
  }


  .award-caption {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--fg-quiet);
  }

  .award-footnote {
    margin: var(--space-s) 0 0;
    max-inline-size: 24rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--fg-quiet);
  }


  .follows {
    margin-block-start: var(--pad-minor);
    padding-block-start: var(--space-l);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .faq-title {
    margin: 0 0 var(--space-l);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

</style>
