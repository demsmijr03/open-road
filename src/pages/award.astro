---
import { Image } from 'astro:assets';
import campusPath from '../assets/campus-path.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';

/*
 * Where you go to school, then the three factors we pick on: ambition, the
 * personal statement, and need. Need is read from the statement rather than
 * assessed as a separate gate, which is why it is a factor and not a filter.
 */
const criteria = [
  { kind: 'Eligibility', title: 'You go to a WCASD high school', detail: 'You are a graduating senior at a West Chester Area School District high school.' },
  { kind: 'Ambition', title: 'A 3.50 GPA or above', detail: 'We look at academic achievement and at what you have done outside the classroom.' },
  { kind: 'Personal statement', title: 'Your story, in your words', detail: 'You apply through our winter essay contest: your story, and what a scholarship would do for your education.' },
  { kind: 'Need', title: 'Your financial need', detail: 'Need is taken into account, as you describe it in your personal statement.' },
];

const faqs = [
  {
    q: 'Who can apply?',
    a: 'Graduating seniors at a West Chester Area School District high school with a 3.50 GPA or above. You apply through our winter essay contest, with a personal statement.',
  },
  {
    q: 'How much is the award?',
    a: "Scholarships come from the gifts we raise and what the fund earns on them. We confirm each year's amount before the essay contest opens.",
  },
  {
    q: 'How is it paid?',
    a: 'Directly to you, as a check. Put it toward tuition, books, a laptop, or the travel to get there.',
  },
  {
    q: 'Can I use it at an out-of-state school?',
    a: 'Yes. In state or out of state, public or private, a four-year or a two-year college. The award goes where you go.',
  },
  {
    q: 'When can I apply?',
    a: "The essay contest opens on January 15. The winner is announced on April 15 and receives the scholarship on May 1. Leave your email and we'll remind you the day it opens.",
  },
  {
    q: 'Who decides?',
    a: 'We do: the five founders, named on the About us page.',
  },
];
---

<BaseLayout
  title="For students | The Open Road Foundation"
  description="Who can apply, how we choose, and how the scholarship reaches you. For graduating seniors in the West Chester Area School District."
>
  <!-- The masthead aside carries the three dates a student plans around.
       No award figure: the scholarship is the fund's return for the year, and
       it is confirmed before the contest opens rather than stated and revised. -->
  <PageHero
    heading="Scholarships for West Chester seniors, every year."
    lede="We are building a community endowment for graduating seniors in the West Chester Area School District. Here is who can apply, how we choose, and how the money reaches you."
  >
    <div slot="aside" class="award-dates">
      <p class="award-dates-label">This school year</p>
      <dl>
        <div><dt>January 15</dt><dd>The essay contest opens</dd></div>
        <div><dt>April 15</dt><dd>The winner is announced</dd></div>
        <div><dt>May 1</dt><dd>The scholarship is paid</dd></div>
      </dl>
    </div>
  </PageHero>

  <!-- The destination, not the origin. This band held a photograph of West
       Chester East, which was wrong twice over: East is one of three district
       high schools, so a student at Rustin or Henderson was being shown
       someone else's building on the page telling them they qualify, and a
       building they already attend is not what makes anyone apply. Students
       walking away down a path, backs to camera, so there is no face to
       misrepresent and the frame is about where the money takes you. -->
  <figure class="school-band reveal">
    <div class="school-media">
      <Image
        src={campusPath}
        alt="Three students with backpacks walking away from the camera across a brick campus plaza toward a university library."
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="lazy"
      />
    </div>
  </figure>

  <section class="section surface-panel">
    <div class="wrap">
      <h2 class="qual-title reveal">What we look for</h2>
      <p class="qual-lede reveal">
        Open to every graduating senior in the district. We choose on three factors.
      </p>
      <!-- Labelled, not numbered. Numbers read as steps, and these are one
           gate and three factors weighed together. The label is the FAQ's own
           name for each, set like the scope labels on the site's statistics. -->
      <ul class="quals">
        {
          criteria.map((c, i) => (
            <li class="qual reveal" style={`--reveal-delay:${i * 110}ms`}>
              <p class="qual-kind">
                <span>{c.kind}</span>
                <span class="qual-rule" aria-hidden="true"></span>
              </p>
              <p class="qual-t">{c.title}</p>
              <p class="qual-d">{c.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section--major surface-base">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">What the award covers</h2>
        <p>
          It's yours to put toward the real cost of going: tuition, books, a laptop, the travel to
          get there. Anything that supports your time at the school you chose.
        </p>
        <p>
          It's paid directly to you, as a check. The money comes from the gifts we raise and what the
          fund earns, and the fund stays invested for the students after you.{' '}
          <a href="/get-involved/#plan">See the plan for the year.</a>
        </p>
      </div>

      <div class="split prose follows">
        <h3>It follows you wherever you go.</h3>
        <p>
          In state or out of state. Public or private. A four-year college or a two-year one. If
          it's the right place for you, the award goes with you.
        </p>
        <p>
          There are no strings on it. Once the award is made it is yours, and what you do next
          is yours.{' '}
          <a href="/about/#why">Why we do it this way.</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section surface-panel">
    <div class="wrap">
      <div class="split prose">
        <h2 class="reveal">How we choose, and when</h2>
        <p>
          We choose the winner: the five founders, named on the About us page. Your teachers and
          district representatives share input on each student, as permitted, and the decision is
          ours.
        </p>
        <p>
          You apply through our winter essay contest, which opens on January 15. Your personal
          statement is your application: your story, and what a scholarship would do for your
          education.
        </p>
        <p>
          We're looking for students who work hard and who want something specific, and who would be
          held back from it by money alone.
        </p>
        <p>
          The winner is announced on April 15 and receives the scholarship on May 1.
        </p>
      </div>
    </div>
  </section>

  <section class="section surface-base" id="questions">
    <div class="wrap">
      <div class="split faq-split">
        <h2 class="faq-title reveal">Questions</h2>
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <CtaBand heading="The essay contest opens in January.">
    <p slot="body">Leave your name and we'll write to you the day it opens.</p>
    <Button href="/get-involved/#interest">Tell us you're interested</Button>
  </CtaBand>
</BaseLayout>

<style>
  /* The accordion fills its column: .split caps children at --width-text, which
     squeezes FAQ rows that already wrap. */
  .faq-split > :not(h2, h3) {
    max-inline-size: none;
  }

  .faq-title {
    margin-block: 0;
  }

  .qual-title {
    margin: 0 0 var(--space-l);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }

  .quals {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .quals { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .quals { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .qual {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-m);
    border-radius: var(--radius-panel);
    background-color: var(--color-surface);
    border: var(--border-hairline) solid var(--rule);
  }

  .qual-lede {
    margin: calc(var(--space-s) * -1) 0 var(--space-l);
    max-inline-size: var(--width-text);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  /* The card's label, drawn like the statistics' scope labels: small caps,
     then a hairline running to the card's edge. */
  .qual-kind {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-2xs);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
    white-space: nowrap;
  }

  .qual-rule {
    flex: 1;
    block-size: var(--border-hairline);
    background-color: var(--rule);
  }

  .qual-t {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
  }

  .qual-d {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .checklist {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .checklist li {
    position: relative;
    padding-inline-start: var(--space-m);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  /* A plain round marker. The lane dash that used to sit here was the road
     motif doing a list's work, and a list does not need a motif. */
  .checklist li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.2rem;
    inset-block-start: 0.72em;
    inline-size: 0.3rem;
    block-size: 0.3rem;
    border-radius: 50%;
    background-color: var(--fg-quiet);
  }

  /* The three dates, in the masthead. A definition list, because each date
     names what happens on it. */
  .award-dates-label {
    margin: 0 0 var(--space-s);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  .award-dates dl {
    display: grid;
    gap: var(--space-s);
    margin: 0;
  }

  .award-dates dl > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-s);
    align-items: baseline;
    padding-block-start: var(--space-s);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .award-dates dt {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .award-dates dd {
    margin: 0;
    color: var(--fg-quiet);
  }

  .follows {
    margin-block-start: var(--pad-minor);
    padding-block-start: var(--space-l);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .faq-title {
    margin: 0 0 var(--space-l);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-h2);
  }


  /* Full-bleed band, from a tall source, so the crop decides what the image is
     about. Set by rendering three positions and looking: high enough to keep
     the building and the receding path in frame, low enough that the three
     figures stay whole rather than being cut at the knee. */
  .school-band {
    margin: 0;
  }

  .school-media {
    position: relative;
    isolation: isolate;
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }

  .school-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }

  /* Colour treatment, per the house rules: a multiply layer in the brand hue
     so the photograph belongs to this palette rather than sitting in its own,
     plus a gradient that grounds the bottom edge against the panel below. */
  .school-media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom, rgb(31 78 74 / 0.18), rgb(31 78 74 / 0.05) 45%, rgb(31 78 74 / 0.3));
  }

  .school-media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background-color: var(--color-deep);
    mix-blend-mode: multiply;
    opacity: 0.14;
  }


  @media (max-width: 48rem) {
    .school-media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
