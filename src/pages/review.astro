---
/**
 * Design review: 21st.dev component audit and a comparison against two
 * reference design systems. Temporary, noindex, excluded from the sitemap.
 *
 * Built on the site's own tokens so the page argues in the same language it is
 * critiquing.
 */
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/figtree';
import '../styles/global.css';

const compare = [
  { prop: 'Body text', mine: '17px / 450 / 1.7', abnb: '18px / 500', eco: '16–20px / 1.4', verdict: 'ok' },
  { prop: 'Section heading', mine: '44px max', abnb: '48px / 700', eco: 'n/a', verdict: 'ok' },
  { prop: 'Display heading', mine: '68px max', abnb: '72px / 700', eco: '54px', verdict: 'ok' },
  { prop: 'Display tracking', mine: '−0.025em', abnb: '−0.03em', eco: 'n/a', verdict: 'ok' },
  { prop: 'Accent colour', mine: 'CTAs, mark, hero word', abnb: 'logo only', eco: 'CTAs only', verdict: 'ok' },
  { prop: 'Shadows', mine: '1 use, skip-link only', abnb: 'none', eco: '1 token, overlays only', verdict: 'ok' },
  { prop: 'Button radius', mine: 'pills, 10px on inputs', abnb: '8px', eco: '9999px', verdict: 'ok' },
  { prop: 'Card radius', mine: '10px', abnb: '12px', eco: '20px', verdict: 'ok' },
  { prop: 'Page max-width', mine: '1152px', abnb: '1200px', eco: '1200px', verdict: 'ok' },
  { prop: 'Card padding', mine: '24px', abnb: '24px', eco: '24px', verdict: 'ok' },
  { prop: 'Section gap', mine: '64–112px', abnb: '64px', eco: '80px', verdict: 'ok' },
];

const findings = [
  {
    n: '01',
    status: 'Shipped. Link hovers change by underline, qualifier numerals and the ways icons went to quiet, and the rotating hero word keeps apricot as the single brand highlight.',
    title: 'The accent is doing too many jobs',
    body: 'Apricot appears 14 times across components: buttons, links, icons, numerals, the logo bar, the footnote star. Airbnb.org restricts its only chromatic colour to the logo. Ecosia restricts lime to CTAs, so "the accent and the photography carry the emotional weight."',
    fix: 'Restrict apricot to primary CTAs. Send links, icons and numerals to deep teal or quiet. One colour with one job reads as confidence; the same colour on six jobs reads as decoration.',
    weight: 'high',
  },
  {
    n: '02',
    status: 'Shipped. One --text-h2 token at clamp(2rem, 4.5vw, 2.75rem), tracking -0.03em, replacing the same clamp repeated in eight files.',
    title: 'Section headings are too quiet',
    body: 'Your h2 tops out at 36px. Airbnb.org sets headings at 48px/700 and display at 72px/700, and describes the whole system as speaking "through scale and silence, not colour or ornament."',
    fix: 'Push h2 to 44–48px and tighten tracking to −0.03em at that size. This is the change that most closely buys the reference aesthetic, and it costs one line.',
    weight: 'high',
  },
  {
    n: '03',
    status: 'Shipped. 17px at weight 450, line-height unchanged at 1.7.',
    title: 'Body copy is small and light',
    body: 'You set 16px at weight 400. Airbnb.org sets 18px at weight 500. At a glance that is the difference between a page that feels drafted and one that feels published.',
    fix: 'Base to 17–18px, body weight to 450–500. Keep your 1.7 line-height: it is more generous than either reference and better for reading.',
    weight: 'high',
  },
  {
    n: '04',
    status: 'Shipped. Both card sets already sat on a panel surface. The tier ladder is now four steps of border weight ending in the filled tile.',
    title: 'Too much elevation',
    body: 'Three shadow tokens, six usages across tier tiles, qualifier cards and the ways-to-help blocks. Airbnb.org uses no shadows and no hover effects at all. Ecosia has exactly one shadow token, reserved for floating stat overlays.',
    fix: 'Drop shadows from cards. Separate them with the panel surface and hairlines instead. Flat plus good type reads as more expensive than lifted cards.',
    weight: 'high',
  },
  {
    n: '05',
    status: 'Shipped. Pills everywhere, with a separate --radius-input so a multi-line textarea is not a pill.',
    title: 'Two button shapes in one system',
    body: 'Header buttons are pills at 9999px; body buttons are 8px. Ecosia commits fully to pills, Airbnb.org fully to 8px. Yours does both, which reads as an accident rather than a distinction.',
    fix: 'Pick one. Given the light-hearted brief, pills everywhere is the stronger choice and matches the softer 10px panels you already chose.',
    weight: 'medium',
  },
  {
    n: '06',
    status: 'Open. This is the one item on the list that code cannot close. Three specific shots are proposed in section 4.',
    title: 'Not enough photography',
    body: 'Both references lean on full-bleed photography as the emotional carrier. Ecosia’s aesthetic is literally "full-bleed leaf photography." You have two photographs on the entire site plus five headshots.',
    fix: 'Two or three more real, local photographs. This is a content blocker, not a code one, and it matters more than any token change on this list.',
    weight: 'medium',
  },
  {
    n: '07',
    status: 'Shipped. Content column 608px to 736px, rail 0.7fr to 0.55fr. The bump to 44px also exposed a row-gap bug in .split, fixed at the same time.',
    title: 'The split rail leaves dead space',
    body: 'A 0.7fr heading rail plus a content column capped at 38rem, inside a 1152px page, leaves a wide empty channel on most sections. Both references run a 1200px container with content that actually fills it.',
    fix: 'Either widen the content column past 38rem or narrow the page so the ratio reads deliberate. Right now it reads as a column that ran out of text.',
    weight: 'medium',
  },
];

const keep = [
  'Body line-height at 1.7, more generous than either reference.',
  'Zero JavaScript beyond a 5.6KB router. Both references ship heavy SPAs.',
  'Contrast rules documented and enforced in one place, with the accent’s three safe variants defined up front.',
  'Motion that degrades safely: content is visible with JS off and inert under reduced-motion.',
  'Card padding at 24px, matching both references exactly.',
];

const steal = [
  {
    name: 'tailark / hero-section-1',
    url: 'https://21st.dev/tailark/hero-section-1/default',
    take: 'The measure discipline. Its eyebrow, headline and lede sit on a hard ~48ch cap while the photograph runs full-bleed behind them. That is the one structural idea your hero does not already use.',
    skip: 'Everything else. It needs lucide-react, and your hero ships 0KB of JavaScript.',
  },
  {
    name: 'prebuiltui / hero-section',
    url: 'https://21st.dev/prebuiltui/hero-section',
    take: 'The scroll-condensing navbar in its animated variant: the header shrinks its padding and gains a hairline once you pass the hero. About fifteen lines of IntersectionObserver here, and it fits the motion system you already have.',
    skip: 'The React state driving it. A single observer toggling one class on <header> does the same job.',
  },
  {
    name: 'ravikatiyar162 / marquee-logo-scroller',
    url: 'https://21st.dev/ravikatiyar162/marquee-logo-scroller',
    take: 'The pattern for the partner tier, once there are partners: a duplicated track translated on a CSS keyframe, paused on hover and on prefers-reduced-motion. No JavaScript at all in the CSS-only version.',
    skip: 'Nothing to build yet. This is the one to come back to after the first Boulevard or Freeway partner signs.',
  },
];

const browse = [
  { label: 'Hero sections', url: 'https://21st.dev/s/hero', note: 'For the measure-and-full-bleed structure above.' },
  { label: 'Calls to action', url: 'https://21st.dev/s/cta', note: 'Compare against CtaBand.astro. Most are a heading, a line and a button, which you already have.' },
  { label: 'Navbars', url: 'https://21st.dev/s/navbar', note: 'The condense-on-scroll behaviour, not the markup.' },
  { label: 'Logo clouds', url: 'https://21st.dev/s/logo-cloud', note: 'Static grid alternative to the marquee, better below about eight logos.' },
  { label: 'Marquees', url: 'https://21st.dev/s/marquee', note: 'Only the CSS-keyframe ones. Skip anything importing Motion.' },
  { label: 'Stats', url: 'https://21st.dev/s/stats', note: 'Worth a look for DistanceStat, though yours is deliberately one figure rather than a row.' },
  { label: 'Accordions', url: 'https://21st.dev/s/accordion', note: 'Yours is a native <details>, which beats every Radix version here on weight and on keyboard support.' },
];

const photos = [
  {
    n: '01',
    title: 'A West Chester Area School District high school, from the sidewalk',
    where: 'For students, above "Who qualifies"',
    why: 'That page carries zero photography today, and it is the page a student actually reads. The first eligibility line is "You go to a WCASD high school." A recognisable building turns that from a rule into a place.',
    consent: 'None needed. Exterior only, shot from the public right-of-way, no legible faces.',
    how: 'Bayard Rustin, B. Reed Henderson or West Chester East. Late afternoon, wide, from across the street so the building sits in its neighbourhood rather than filling the frame. 3:2 landscape, 2400px or wider.',
    when: 'Today',
  },
  {
    n: '02',
    title: 'The first fundraiser, shot as a room rather than as faces',
    where: 'Get involved, beside "The plan for year one"',
    why: 'The plan names five months and the tier ladder asks for $1,500, with nothing on the page showing that any of it is real. One photograph of an actual room does more for that ask than a fourth bullet.',
    consent: 'Required for anyone identifiable. Shoot over shoulders, hands on a table, the counter, the room from the back. Get a signed release for any face that is legible, and keep it with the file.',
    how: 'Available light, no flash. Horizontal for the section, and grab a vertical of the same moment for social. This is the only one of the three you cannot shoot today: it needs the November reunion or the March coffee day to happen first.',
    when: 'Nov or Mar',
  },
  {
    n: '03',
    title: 'A still life for the closing band',
    where: 'CtaBand, which closes all four pages',
    why: 'That band is type on flat teal on every page, and it is the last thing every visitor sees. It is also the only place a photograph would appear site-wide from a single file.',
    consent: 'None. No people in frame.',
    how: 'An acceptance envelope on a kitchen table, or a lanyard and a set of keys. Deliberately not another packed car: the hero already owns that image, and repeating it would flatten both. Overlay a gradient plus a deep-teal mix-blend-multiply layer so white text clears 4.5:1 over it.',
    when: 'Today',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Design review</title>
  </head>
  <body class="surface-base">
    <header class="masthead wrap">
      <p class="kicker">Design review</p>
      <h1>Where this site sits against Airbnb.org and Ecosia.</h1>
      <p class="lede">
        Two questions: whether anything on 21st.dev is worth installing, and what the two reference
        systems do that this one does not. The second half is the useful half.
      </p>
    </header>

    <!-- 21ST.DEV -->
    <section class="wrap block">
      <h2>1. 21st.dev, without the dependency</h2>

      <div class="verdict">
        <p class="verdict-lead">Copy the patterns. Install nothing.</p>
        <p>
          21st.dev is a React, shadcn, Radix and Tailwind registry. This site has no React and
          ships 5.6KB of JavaScript in total. Adopting one component means adding
          <code>@astrojs/react</code>, <code>react</code> and <code>react-dom</code> before the
          component's own dependencies, and hydrating an island on a static brochure page. Every
          link below is worth opening; none of them is worth installing.
        </p>
      </div>

      <h3 class="sub">Three worth opening</h3>
      <ul class="steal">
        {
          steal.map((s) => (
            <li class="steal-item">
              <a class="steal-name" href={s.url} rel="noopener noreferrer" target="_blank">
                {s.name}
              </a>
              <p><strong>Take.</strong> {s.take}</p>
              <p class="dim"><strong>Leave.</strong> {s.skip}</p>
            </li>
          ))
        }
      </ul>

      <h3 class="sub">Categories to browse</h3>
      <p class="note">
        Search pages rather than single components, so they stay useful as the registry changes.
      </p>
      <ul class="browse">
        {
          browse.map((b) => (
            <li>
              <a href={b.url} rel="noopener noreferrer" target="_blank">{b.label}</a>
              <span class="dim">{b.note}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- COMPARISON -->
    <section class="wrap block">
      <h2>2. Side by side</h2>
      <p class="note">
        Airbnb.org is Airbnb's nonprofit arm, which makes it a direct peer. Both reference systems
        were read from their published design tokens rather than screenshots; both sites block
        automated capture.
      </p>

      <table class="spec spec--compare">
        <thead>
          <tr><th>Property</th><th>Open Road</th><th>Airbnb.org</th><th>Ecosia</th><th /></tr>
        </thead>
        <tbody>
          {
            compare.map((row) => (
              <tr>
                <td><strong>{row.prop}</strong></td>
                <td>{row.mine}</td>
                <td class="dim">{row.abnb}</td>
                <td class="dim">{row.eco}</td>
                <td>
                  <span class:list={['flag', `flag--${row.verdict}`]}>
                    {row.verdict === 'fix' ? 'change' : 'fine'}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <!-- FINDINGS -->
    <section class="wrap block">
      <h2>3. Seven changes, ranked</h2>
      <p class="note">Six are in. The seventh is photography, which no amount of CSS closes.</p>
      <ol class="findings">
        {
          findings.map((f) => (
            <li class="finding">
              <div class="finding-n">
                <span>{f.n}</span>
                <span class:list={['weight', `weight--${f.weight}`]}>{f.weight}</span>
              </div>
              <div class="finding-body">
                <h3>{f.title}</h3>
                <p>{f.body}</p>
                <p class="finding-fix"><strong>Do this.</strong> {f.fix}</p>
                <p class:list={['finding-status', f.status.startsWith('Shipped') ? 'is-done' : 'is-open']}>
                  {f.status}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- PHOTOGRAPHY -->
    <section class="wrap block">
      <h2>4. Three photographs to take</h2>
      <p class="note">
        The site has two photographs and five headshots. Both reference systems lean on
        photography as the emotional carrier, and this is the gap between them and here. These
        three are ordered by how soon you can shoot them, not by importance.
      </p>

      <ol class="photos">
        {
          photos.map((ph) => (
            <li class="photo">
              <div class="photo-n">
                <span>{ph.n}</span>
                <span class="photo-when">{ph.when}</span>
              </div>
              <div class="photo-body">
                <h3>{ph.title}</h3>
                <p class="photo-where">{ph.where}</p>
                <p>{ph.why}</p>
                <p class="dim"><strong>Consent.</strong> {ph.consent}</p>
                <p class="dim"><strong>How.</strong> {ph.how}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="note">
        Two things to avoid. Do not buy stock: a generic group of students on a lawn would undo
        the credibility the copy has earned, and both reference sites are convincing precisely
        because their images are specific and un-bought. And do not photograph a funded student
        until there is one and they have agreed in writing, which is a rule worth keeping even
        when it costs the better picture.
      </p>
    </section>

    <!-- KEEP -->
    <section class="wrap block">
      <h2>5. Keep</h2>
      <ul class="keep">
        {keep.map((k) => <li>{k}</li>)}
      </ul>
      <p class="note">
        The single sentence worth taking from Airbnb.org: <em>the page speaks through scale and
        silence, not colour or ornament.</em> Findings 01 through 04 are all that sentence, applied.
      </p>
    </section>

    <footer class="wrap foot">
      <p>Temporary page. Not linked from the site and excluded from the sitemap.</p>
    </footer>
  </body>
</html>

<style>
  body {
    padding-block: var(--space-2xl) 0;
  }

  .masthead {
    padding-block-end: var(--space-2xl);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  .kicker {
    margin: 0 0 var(--space-2xs);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  .masthead h1 {
    margin: 0;
    max-inline-size: 22ch;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .lede {
    margin: var(--space-m) 0 0;
    max-inline-size: var(--width-text);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .block {
    padding-block: var(--space-2xl);
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  .block h2 {
    margin: 0 0 var(--space-m);
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: var(--tracking-display);
  }

  .note {
    margin: var(--space-m) 0 0;
    max-inline-size: var(--width-wide);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  /* --- verdict ---------------------------------------------------------- */

  .verdict {
    padding: var(--space-m);
    border-radius: var(--radius-panel);
    background-color: var(--color-panel);
    max-inline-size: var(--width-wide);
    margin-block-end: var(--space-l);
  }

  .verdict-lead {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .verdict p:last-child {
    margin: 0;
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  code {
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background-color: color-mix(in srgb, var(--fg) 8%, transparent);
  }

  /* --- tables -----------------------------------------------------------

     Named .spec, not .grid: `grid` is a Tailwind utility that sets
     display: grid, so a table carrying that class stopped being a table and
     laid its cells out as grid items. Same trap as the --spacing-3xl token
     that once hijacked max-w-3xl. Avoid utility names for custom classes. */

  .spec {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .spec th {
    text-align: start;
    padding: 0 var(--space-s) var(--space-2xs) 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
    border-block-end: var(--border-hairline) solid var(--rule-strong);
  }

  .spec td {
    padding: var(--space-s) var(--space-s) var(--space-s) 0;
    border-block-end: var(--border-hairline) solid var(--rule);
    line-height: 1.55;
    vertical-align: top;
  }

  .dim {
    color: var(--fg-quiet);
  }

  /* table-layout: fixed, because with `auto` the percentage widths below are
     only hints: the browser sizes columns to their content and hands the
     slack to one of them, which clustered five short columns into the left
     half of a table that was already the full width of the page. */
  .spec--compare {
    table-layout: fixed;
  }

  .spec--compare th:first-child,
  .spec--compare td:first-child {
    inline-size: 22%;
  }

  .spec--compare th:nth-child(2),
  .spec--compare td:nth-child(2),
  .spec--compare th:nth-child(3),
  .spec--compare td:nth-child(3),
  .spec--compare th:nth-child(4),
  .spec--compare td:nth-child(4) {
    inline-size: 21%;
  }

  .spec--compare th:last-child,
  .spec--compare td:last-child {
    inline-size: 15%;
    text-align: end;
  }

  .flag {
    display: inline-block;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .flag--fix {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .flag--ok {
    background-color: color-mix(in srgb, var(--fg) 8%, transparent);
    color: var(--fg-quiet);
  }

  /* --- findings --------------------------------------------------------- */

  .findings {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .finding {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-m);
    padding-block-start: var(--space-m);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .finding-n {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--fg-quiet);
  }

  .weight {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .weight--high {
    color: var(--color-accent-strong);
  }

  .weight--medium {
    color: var(--fg-quiet);
  }

  .finding-body h3 {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-xl);
    letter-spacing: -0.015em;
  }

  .finding-body p {
    margin: 0;
    max-inline-size: var(--width-wide);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .finding-fix {
    margin-block-start: var(--space-s) !important;
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid var(--color-accent);
  }

  .finding-fix strong {
    color: var(--fg);
  }

  /* --- keep ------------------------------------------------------------- */

  .keep {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
    max-inline-size: var(--width-wide);
  }

  .keep li {
    position: relative;
    padding-inline-start: var(--space-m);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .keep li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.2rem;
    inset-block-start: 0.72em;
    inline-size: 0.3rem;
    block-size: 0.3rem;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .foot {
    padding-block: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--fg-quiet);
  }

  .foot p {
    margin: 0;
  }

  @media (max-width: 48rem) {
    .finding {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }

    .finding-n {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-s);
    }

    .spec {
      font-size: var(--text-xs);
    }
  }
  /* --- 21st.dev links ---------------------------------------------------- */
  .sub {
    margin-block: var(--space-l) var(--space-s);
    font-size: var(--text-xl);
  }

  .steal,
  .browse,
  .photos {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steal-item {
    padding-block: var(--space-s);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .steal-item p {
    margin: var(--space-3xs) 0 0;
    max-inline-size: 68ch;
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .steal-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--fg);
