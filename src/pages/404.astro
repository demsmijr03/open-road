---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
---

<BaseLayout
  title="Dead end | The Open Road Foundation"
  description="That page doesn't exist."
  noindex
>
  <section class="notfound surface-deep">
    <div class="wrap notfound-grid">
      <!-- Load-in rather than scroll reveal: this page is one screen, so there
           is nothing below the fold for an observer to trigger on. Without it,
           arriving here from an animated page read as the site breaking. -->
      <div>
        <span class="eyebrow rise" style="--rise-delay:80ms">404</span>
        <h1 class="rise" style="--rise-delay:160ms">Dead end.</h1>
        <p class="notfound-body rise" style="--rise-delay:280ms">
          That page doesn't exist, or it moved and we didn't put up a sign. Here's the way back.
        </p>
        <ul class="notfound-links rise" style="--rise-delay:400ms">
          <li><a href="/">Home</a></li>
          <li><a href="/award/">For students</a></li>
          <li><a href="/about/">About us</a></li>
          <li><a href="/get-involved/">Get involved</a></li>
        </ul>
      </div>

      <div class="notfound-mark rise" style="--rise-delay:520ms">
        <Logo variant="mark" decorative />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--pad-major);
  }

  .notfound-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-xl);
    align-items: center;
  }

  .notfound h1 {
    margin: var(--space-s) 0 var(--space-m);
    font-size: clamp(2.5rem, 7vw, 4rem);
  }


  .notfound-body {
    margin: 0;
    max-inline-size: var(--width-text);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin: var(--space-l) 0 0;
    padding: 0;
    list-style: none;
  }

  .notfound-links a {
    display: inline-block;
    padding-block: 0.6rem;
    color: var(--fg);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--rule-strong);
  }

  .notfound-links a:hover {
    text-decoration-color: var(--fg);
  }

  .notfound-links a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .notfound-mark {
    inline-size: min(100%, 15rem);
    margin-inline: auto;
    color: var(--fg);
  }

  @media (max-width: 60rem) {
    .notfound-grid {
      grid-template-columns: 1fr;
    }

    .notfound-mark {
      inline-size: min(100%, 11rem);
      margin-inline: 0;
    }
  }
</style>
