---
import Placeholder from './Placeholder.astro';

/**
 * The year-one plan, drawn as a road.
 *
 * The content is a sequence with real dates, so numbered/ordered treatment is
 * earned here rather than decorative, this is the one place on the site where
 * order carries information the reader needs.
 *
 * Milestones without a date yet keep their slot and show the hole, so the shape
 * of the year is honest about what is still unscheduled.
 */
interface Props {
  items: { when: string; whenPlaceholder?: string; what: string; detail?: string }[];
}

const { items } = Astro.props;
---

<ol class="rail">
  {
    items.map((item) => (
      <li class="rail-item">
        <div class="rail-marker" aria-hidden="true" />
        <div class="rail-content">
          <div class="rail-when">
            {item.whenPlaceholder ? (
              <Placeholder note={item.whenPlaceholder} as="inline" />
            ) : (
              <span class="rail-date">{item.when}</span>
            )}
          </div>
          <p class="rail-what">{item.what}</p>
          {item.detail && <p class="rail-detail">{item.detail}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .rail {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail-item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-m);
    padding-block: var(--space-m);
  }

  /* A hairline connecting the markers. */
  .rail-item::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 5px;
    inline-size: 1px;
    background-color: var(--rule-strong);
  }

  .rail-item:first-child::before {
    inset-block-start: 50%;
  }

  .rail-item:last-child::before {
    inset-block-end: 50%;
  }

  .rail-marker {
    position: relative;
    z-index: 1;
    inline-size: 12px;
    block-size: 12px;
    margin-block-start: 0.45rem;
    border-radius: 50%;
    background-color: var(--bg);
    box-shadow: inset 0 0 0 3px var(--fg);
  }

  .rail-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .rail-date {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  .rail-what {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--fg);
  }

  .rail-detail {
    margin: var(--space-2xs) 0 0;
    max-inline-size: 34rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  /*
    The detail is shown outright by default. It only collapses where hovering is
    genuinely available, so touch users and anyone on a narrow screen read the
    whole timeline without needing to hover something they cannot hover.

    A hover-only reveal here would have hidden five descriptions from every
    phone on the internet.
  */
  @media (hover: hover) and (pointer: fine) {
    .rail-detail {
      overflow: hidden;
      max-block-size: 0;
      opacity: 0;
      margin-block-start: 0;
      transition:
        max-block-size 420ms var(--ease-spring),
        opacity 300ms var(--ease-spring),
        margin-block-start 420ms var(--ease-spring);
    }

    /* focus-within as well as hover: the row contains links on some pages, and
       a keyboard user tabbing through should see the same thing a mouse does. */
    .rail-item:hover .rail-detail,
    .rail-item:focus-within .rail-detail {
      max-block-size: 12rem;
      opacity: 1;
      margin-block-start: var(--space-2xs);
    }

    .rail-item {
      transition: opacity 300ms var(--ease-spring);
    }

    /* The hovered row stays at full strength while its neighbours step back,
       so the eye lands on the one being read. */
    .rail:hover .rail-item:not(:hover) {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-detail,
    .rail-item {
      transition: none;
    }
  }
</style>
