---
/**
 * A fact that is sourced but not yet confirmed against its primary source.
 *
 * content.md: "it must not go live until a founder checks it."
 *
 * The claim renders — a founder cannot check a fact they cannot see — marked
 * with a dotted underline and a small flag. This component is strictly inline:
 * an earlier version rendered the explanation as a block inside the paragraph,
 * which cut the sentence in half. The explanation belongs in <VerifyNote />,
 * placed after the paragraph.
 *
 * Launch blocker. `npm run audit:holes` counts these.
 */
---

<span class="verify" data-verify><slot /><span class="verify-flag">check</span></span>

<style>
  .verify {
    /* A dotted underline, not a highlight — the claim stays readable. */
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--color-amber);
  }

  .verify-flag {
    display: inline-block;
    margin-inline-start: 0.35em;
    padding: 0.05em 0.4em;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--color-amber) 30%, var(--bg));
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    vertical-align: 0.25em;
    white-space: nowrap;
  }
</style>
