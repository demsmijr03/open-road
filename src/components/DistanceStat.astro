---
/**
 * A single sourced fact, set at display size.
 *
 * This used to carry a "distance" system: three stats on the home page, each
 * scaled and coloured by how far from West Chester the fact was, so the reader
 * walked in from a national horizon to their own district. That worked only
 * while all three sat together.
 *
 * The facts are now split up. The home page keeps the local one, because a
 * statistic is a poor substitute for a person and one is enough at the top of a
 * donation funnel; the national and state figures moved into the About page's
 * narrative, where a reader who wants the wider case is already looking. With
 * nothing left to compare against on either page, relative scaling would have
 * read as arbitrary emphasis rather than as distance, so it is gone.
 *
 * What remains is one consistent treatment. `scale` adjusts presence for
 * context, not for meaning.
 */
interface Props {
  scope: string;
  figure: string;
  source: string;
  /** `lead` for a fact carrying a section on its own, `inline` inside prose. */
  scale?: 'lead' | 'inline';
}

const { scope, figure, source, scale = 'lead' } = Astro.props;
---

<article class="stat" data-scale={scale}>
  <div class="stat-head">
    <span class="stat-scope">{scope}</span>
    <span class="stat-rule" aria-hidden="true"></span>
  </div>

  <p class="stat-figure">{figure}</p>

  <div class="stat-body"><slot /></div>
  <p class="stat-source">{source}</p>
</article>

<style>
  /* One column. The figure sits directly above the sentence explaining it,
     which is what the old two-column split kept pulling apart. */
  .stat {
    display: block;
    max-inline-size: var(--stat-measure);
  }

  .stat-head {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-end: var(--space-2xs);
  }

  .stat-scope {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
    white-space: nowrap;
  }

  .stat-rule {
    flex: 1;
    min-inline-size: 2rem;
    block-size: 2px;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--fg) 28%, transparent);
  }

  .stat-figure {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    color: var(--fg);
    font-size: var(--stat-size);
  }

  .stat-body {
    margin-block-start: var(--space-s);
    color: var(--fg-quiet);
    line-height: var(--leading-body);
    font-size: var(--stat-body);
  }

  .stat-body :global(p) {
    margin: 0;
  }

  .stat-source {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--fg-quiet);
  }

  /* Carrying a section on its own. */
  .stat[data-scale='lead'] {
    --stat-measure: 34rem;
    --stat-size: clamp(3.5rem, 9vw, 5rem);
    --stat-body: var(--text-lg);
  }

  /* Sitting inside a run of prose, so it reads as part of the argument rather
     than as an interruption. */
  .stat[data-scale='inline'] {
    --stat-measure: 100%;
    --stat-size: clamp(2.25rem, 5vw, 2.75rem);
    --stat-body: var(--text-base);
  }
</style>
