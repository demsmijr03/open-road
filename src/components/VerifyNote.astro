---
/**
 * The explanation behind a <Verify /> mark: why the fact is in doubt and what
 * would settle it. Sits after the paragraph, never inside it.
 */
interface Props {
  note: string;
}

const { note } = Astro.props;
---

<p class="verify-note" data-verify-note>
  <span class="verify-note-tag">Check before publish</span>
  {note}
</p>

<style>
  .verify-note {
    margin: var(--space-2xs) 0 0;
    padding-inline-start: var(--space-xs);
    border-inline-start: 2px solid var(--color-amber);
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--fg-quiet);
  }

  .verify-note-tag {
    display: block;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-size: 0.625rem;
    color: var(--fg);
  }
</style>
