---
/**
 * A tiny icon set, drawn rather than imported.
 *
 * Four strokes in the prism's language: 24 unit grid, 1.75 stroke, round caps,
 * no fills. An icon library would bring hundreds of glyphs drawn to someone
 * else's grid, and four is all this site needs.
 *
 * Each is a geometric idea, not a picture: giving is a widening arc, partnering
 * is two overlapping frames, asking is a line meeting a point, telling is one
 * line becoming several. That last one is the mark itself, which is deliberate.
 */
interface Props {
  name: 'give' | 'partner' | 'ask' | 'tell';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    /* GIVE. An open hand as a cupped arc, with something leaving it upward. */
    name === 'give' && (
      <>
        <path d="M4 15 C4 19 7.6 21.5 12 21.5 C16.4 21.5 20 19 20 15" />
        <path d="M12 13.5 L12 3" />
        <path d="M8.4 6.4 L12 3 L15.6 6.4" />
      </>
    )
  }

  {
    /* PARTNER. Two frames overlapping: two organisations, shared ground. */
    name === 'partner' && (
      <>
        <rect x="3" y="3" width="12.5" height="12.5" rx="2.5" />
        <rect x="8.5" y="8.5" width="12.5" height="12.5" rx="2.5" />
      </>
    )
  }

  {
    /* ASK. A line arriving at a point: a question reaching someone. */
    name === 'ask' && (
      <>
        <path d="M3 6.5 A2.5 2.5 0 0 1 5.5 4 H18.5 A2.5 2.5 0 0 1 21 6.5 V15 A2.5 2.5 0 0 1 18.5 17.5 H9 L4.5 21 V17.5 A2.5 2.5 0 0 1 3 15 Z" />
      </>
    )
  }

  {
    /* TELL. One line becoming several: the mark, at icon scale. */
    name === 'tell' && (
      <>
        <path d="M3 12 H8.5" />
        <path d="M10 5.5 V18.5" />
        <path d="M11.8 12 L21 6.5" />
        <path d="M11.8 12 H21" />
        <path d="M11.8 12 L21 17.5" />
      </>
    )
  }
</svg>

<style>
  svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
