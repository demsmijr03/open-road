---
/**
 * A tiny icon set, drawn rather than imported.
 *
 * Three strokes on a 24 unit grid, 1.75 stroke, round caps, no fills. An icon
 * library would bring hundreds of glyphs drawn to someone else's grid, and this
 * many is all this site needs.
 *
 * Each is a geometric idea, not a picture: giving is a widening arc, partnering
 * is two overlapping frames, asking is a line meeting a point.
 *
 * `tell` is the exception and is not drawn here at all. It used to be the Prism
 * mark redrawn at icon scale, which is why it survived the mark swap: the sweep
 * for the old artwork searched for its 48 grid path data and this was a hand
 * copy on the 24 grid. It is now the real Sightline mark, rendered from the
 * same two paths as Logo.astro on its own 48 viewBox rather than rescaled onto
 * this one, because that path data is never edited.
 */
interface Props {
  name: 'give' | 'partner' | 'ask' | 'tell';
  class?: string;
}

const { name, class: className = '' } = Astro.props;

/* The mark is filled and lives on a 48 grid; the drawn icons are stroked on a
   24 grid. Nothing sensible merges those two, so `tell` takes its own element
   below rather than bending this one's attributes around it. */
const isMark = name === 'tell';
---

{
  isMark ? (
    <svg
      class={className}
      viewBox="0 0 48 48"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M5.1850 21.3552 L42.4975 19.6592 A19 19 0 0 0 5.1850 21.3552 Z"
        fill="var(--color-accent)"
      />
      <path
        d="M5.1850 26.6448 L42.4975 28.3408 A19 19 0 0 1 5.1850 26.6448 Z"
        fill="currentColor"
      />
    </svg>
  ) : (
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    /* GIVE. An open hand as a cupped arc, with something leaving it upward. */
    name === 'give' && (
      <>
        <path d="M4 15 C4 19 7.6 21.5 12 21.5 C16.4 21.5 20 19 20 15" />
        <path d="M12 13.5 L12 3" />
        <path d="M8.4 6.4 L12 3 L15.6 6.4" />
      </>
    )
  }

  {
    /* PARTNER. Two frames overlapping: two organisations, shared ground. */
    name === 'partner' && (
      <>
        <rect x="3" y="3" width="12.5" height="12.5" rx="2.5" />
        <rect x="8.5" y="8.5" width="12.5" height="12.5" rx="2.5" />
      </>
    )
  }

  {
    /* ASK. A line arriving at a point: a question reaching someone. */
    name === 'ask' && (
      <>
        <path d="M3 6.5 A2.5 2.5 0 0 1 5.5 4 H18.5 A2.5 2.5 0 0 1 21 6.5 V15 A2.5 2.5 0 0 1 18.5 17.5 H9 L4.5 21 V17.5 A2.5 2.5 0 0 1 3 15 Z" />
      </>
    )
  }
</svg>
  )
}

<style>
  svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
