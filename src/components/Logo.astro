---
/**
 * The Open Road Foundation mark.
 *
 * Brief: a road as the base, a small person guided by a hand, fused with the
 * college idea and with perspective.
 *
 * How it was developed:
 *  - A mortarboard seen at an angle and a road seen in perspective are the same
 *    trapezoid. The first attempt put a cap at the far end of a receding road,
 *    but at any real size the cap sat wider than the road's vanishing point and
 *    read as a lamp on a tripod. So the composition inverted: the cap is the
 *    fixed point at the top, and the road opens out from beneath it toward the
 *    viewer.
 *  - That inversion is what makes the perspective legible. The road widens as
 *    it approaches and its lane markings grow with it, so the drawing is read
 *    from the horizon forward, the same move the home page's three numbers
 *    make, and the same one the foundation's argument makes.
 *  - The tassel hangs in the lane-marking dash rhythm, tying the two halves
 *    into one drawing rather than a mashup.
 *  - In `scene`, the hand is an open arc beside the figure. It never touches.
 *    The figure walks on their own, the real relationship a scholarship has to
 *    a student, and the difference between guidance and rescue.
 *
 * Variants:
 *   mark: cap, road, lane. Two shapes; survives 16px.
 *   full: mark plus wordmark lockup.
 *   scene: adds the figure and the guiding hand. 120px and up only.
 */
interface Props {
  variant?: 'full' | 'mark' | 'scene';
  class?: string;
  decorative?: boolean;
}

const { variant = 'mark', class: className = '', decorative = false } = Astro.props;

const a11y = decorative
  ? ({ 'aria-hidden': 'true', focusable: 'false' } as const)
  : ({ role: 'img', 'aria-label': 'The Open Road Foundation' } as const);
---

{
  variant === 'full' ? (
    <span class={`logo-lockup ${className}`}>
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path d="M21.8 22 L26.2 22 L40 45 L8 45 Z" fill="currentColor" opacity="0.18" />
        <path d="M21.8 22 L8 45 M26.2 22 L40 45" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <g stroke="var(--lane, #e9a116)" stroke-linecap="round">
          <line x1="24" y1="25" x2="24" y2="28.5" stroke-width="1.7" />
          <line x1="24" y1="32" x2="24" y2="36.5" stroke-width="2.4" />
          <line x1="24" y1="40" x2="24" y2="44" stroke-width="3.1" />
        </g>
        <path d="M24 5 L43 13 L24 21 L5 13 Z" fill="currentColor" />
        <g stroke="var(--lane, #e9a116)" stroke-linecap="round" stroke-width="1.8">
          <line x1="41.5" y1="15.4" x2="41.5" y2="19" />
        </g>
      </svg>
      <span class="logo-words">
        <span class="logo-name">Open Road</span>
        <span class="logo-sub">Foundation</span>
      </span>
    </span>
  ) : (
    <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" {...a11y}>
      {/* Road surface, opening out from under the cap toward the viewer */}
      <path d="M21.8 22 L26.2 22 L40 45 L8 45 Z" fill="currentColor" opacity="0.18" />
      <path d="M21.8 22 L8 45 M26.2 22 L40 45" stroke="currentColor" stroke-width="2" stroke-linecap="round" />

      {/* Lane markings, grow as they approach */}
      <g stroke="var(--lane, #e9a116)" stroke-linecap="round">
        <line x1="24" y1="25" x2="24" y2="28.5" stroke-width="1.7" />
        <line x1="24" y1="32" x2="24" y2="36.5" stroke-width="2.4" />
        <line x1="24" y1="40" x2="24" y2="44" stroke-width="3.1" />
      </g>

      {/* The mortarboard, the fixed point the road runs from */}
      <path d="M24 5 L43 13 L24 21 L5 13 Z" fill="currentColor" />

      {/* Tassel, hanging in the lane-marking rhythm */}
      <g stroke="var(--lane, #e9a116)" stroke-linecap="round" stroke-width="1.8">
        <line x1="41.5" y1="15.4" x2="41.5" y2="19" />
      </g>

      {variant === 'scene' && (
        <>
          {/* The guiding hand: a cupped palm behind the figure. A thin arc read
              as a stray curve, so it carries weight and a thumb. It stops short
              of the figure. Near, but never holding. */}
          <path
            d="M4.2 43.8 C2.2 36 4 29.4 9 25.8 L10.9 28.6 C7.2 31.3 5.9 36.4 7.5 42.8 Z"
            fill="currentColor"
            opacity="0.42"
          />
          <path
            d="M9 25.8 C10 24.2 11.6 23.8 12.5 24.8"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            opacity="0.42"
          />
          {/* The figure, walking away toward the cap */}
          <circle cx="16.6" cy="32.6" r="2.1" fill="currentColor" />
          <path
            d="M16.6 35.4 L16.6 40.2 M16.6 37 L14.5 39.3 M16.6 37 L18.7 39.3"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </>
      )}
    </svg>
  )
}

<style>
  svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .logo-lockup svg {
    inline-size: 2.25rem;
    flex: none;
  }

  .logo-words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .logo-sub {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
    margin-block-start: 0.2rem;
  }
</style>
