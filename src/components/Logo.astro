---
/**
 * The Open Road Foundation mark: Sightline.
 *
 * A disc cut by a slot that opens toward the right. Two filled paths and
 * nothing else. It replaced the Prism mark, whose three diverging rays turned
 * to mud below about 24px and needed a separate hand-reduced favicon to survive
 * at all.
 *
 * Three rules from the design handoff, none of which bend:
 *
 *   - No ids, masks or clipPaths. An earlier version used ids and they collided
 *     when two copies of the mark rendered on one page.
 *   - The path data is never edited. The slot is deliberately not level and
 *     opens to the right; levelling or reversing it is not a simplification.
 *   - Both halves are tokens, never hex. The upper half is always apricot. The
 *     lower half is currentColor, which resolves through the surface tokens to
 *     white inside a deep band and to deep teal on a light one, which is
 *     exactly the two treatments the handoff specifies for the two grounds.
 *
 * Variants:
 *   mark: the disc alone.
 *   full: mark plus the wordmark lockup.
 */
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
  decorative?: boolean;
}

const { variant = 'mark', class: className = '', decorative = false } = Astro.props;

const a11y = decorative
  ? ({ 'aria-hidden': 'true', focusable: 'false' } as const)
  : ({ role: 'img', 'aria-label': 'The Open Road Foundation' } as const);
---

{
  variant === 'full' ? (
    <span class={`logo-lockup ${className}`}>
      <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path
          d="M5.1850 21.3552 L42.4975 19.6592 A19 19 0 0 0 5.1850 21.3552 Z"
          fill="var(--color-accent)"
        />
        <path
          d="M5.1850 26.6448 L42.4975 28.3408 A19 19 0 0 1 5.1850 26.6448 Z"
          fill="currentColor"
        />
      </svg>
      <span class="logo-words">
        <span class="logo-name">Open Road</span>
        <span class="logo-sub">Foundation</span>
      </span>
    </span>
  ) : (
    <svg class={className} viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" {...a11y}>
      <path
        d="M5.1850 21.3552 L42.4975 19.6592 A19 19 0 0 0 5.1850 21.3552 Z"
        fill="var(--color-accent)"
      />
      <path
        d="M5.1850 26.6448 L42.4975 28.3408 A19 19 0 0 1 5.1850 26.6448 Z"
        fill="currentColor"
      />
    </svg>
  )
}

<style>
  svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .logo-lockup svg {
    inline-size: 2.25rem;
    flex: none;
  }

  .logo-words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .logo-sub {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
    margin-block-start: 0.2rem;
  }
</style>
