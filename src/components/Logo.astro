---
/**
 * The Open Road Foundation mark: Prism.
 *
 * One line goes in, three come out. A single student, and the wider range of
 * what they can see afterwards. That is the whole idea, and it is why this
 * replaced the previous drawing of a road running into a mortarboard: the name
 * already carries the road, every other Open Road organisation leans on it, and
 * the campus was never what the foundation is about.
 *
 * The bar is the one apricot element. Apricot is graphic-only everywhere on the
 * site (2.34:1 on white, 3.99:1 on the deep band), which is exactly what a
 * stroke in a mark is.
 *
 * Variants:
 *   mark: the prism alone. Survives 16px once the outer rays drop away.
 *   full: mark plus the wordmark lockup.
 */
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
  decorative?: boolean;
}

const { variant = 'mark', class: className = '', decorative = false } = Astro.props;

const a11y = decorative
  ? ({ 'aria-hidden': 'true', focusable: 'false' } as const)
  : ({ role: 'img', 'aria-label': 'The Open Road Foundation' } as const);
---

{
  variant === 'full' ? (
    <span class={`logo-lockup ${className}`}>
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path d="M5 24 L16.4 24" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" />
        <path d="M18.5 11 L18.5 37" stroke="var(--color-accent)" stroke-width="3.6" stroke-linecap="round" />
        <g stroke="currentColor" stroke-linecap="round" stroke-width="2.5">
          <path d="M21 24 L43 13.5" opacity="0.42" />
          <path d="M21 24 L44 24" opacity="0.72" />
          <path d="M21 24 L43 34.5" opacity="0.42" />
        </g>
      </svg>
      <span class="logo-words">
        <span class="logo-name">Open Road</span>
        <span class="logo-sub">Foundation</span>
      </span>
    </span>
  ) : (
    <svg class={className} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" {...a11y}>
      {/* The line going in */}
      <path d="M5 24 L16.4 24" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" />
      {/* The prism itself */}
      <path d="M18.5 11 L18.5 37" stroke="var(--color-accent)" stroke-width="3.6" stroke-linecap="round" />
      {/* Three coming out. The outer two carry less weight so the mark reads as
          one thing rather than as a starburst. */}
      <g stroke="currentColor" stroke-linecap="round" stroke-width="2.5">
        <path d="M21 24 L43 13.5" opacity="0.42" />
        <path d="M21 24 L44 24" opacity="0.72" />
        <path d="M21 24 L43 34.5" opacity="0.42" />
      </g>
    </svg>
  )
}

<style>
  svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .logo-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .logo-lockup svg {
    inline-size: 2.25rem;
    flex: none;
  }

  .logo-words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .logo-sub {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
    margin-block-start: 0.2rem;
  }
</style>
