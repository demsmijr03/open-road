---
import { Image } from 'astro:assets';
import campusDusk from '../assets/campus-dusk.jpg';

/**
 * The closing band. Every page ends on one, always on the deep surface, so the site has
 * a consistent last beat and the dark surface stays meaningful by appearing
 * exactly twice per page at most.
 */
interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<section class="cta surface-deep">
  <!-- Decorative, hence the empty alt: the band's argument is made in the
       heading, and a screen reader gains nothing from a description of a
       building at dusk. It is a college somewhere else, which is the whole
       point of the fund, and deliberately not a road. -->
  <div class="cta-media" aria-hidden="true">
    <Image src={campusDusk} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="lazy" />
  </div>

  <div class="cta-inner">
    <h2 class="cta-heading">{heading}</h2>
    <div class="cta-body"><slot name="body" /></div>
    <div class="cta-actions"><slot /></div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--pad-major);
  }

  /* The scrim is heavy on purpose. This band carries white body copy and a
     white-on-apricot button, and both have to hold their measured contrast over
     whatever part of the photograph they land on, at every viewport. Treating
     the image as texture under a near-solid deep ground is what makes that
     true by construction rather than by luck. */
  .cta-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta-media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    filter: saturate(0.6);
  }

  .cta-media::before {
    content: '';
    position: absolute;
    inset: 0;
    /* Positive z-index inside a negative-z parent: the parent forms a stacking
       context, and a negative-z child there paints before the parent's in-flow
       content, which would put the scrim underneath the photograph. */
    z-index: 1;
    background-color: var(--color-deep);
    mix-blend-mode: multiply;
  }

  .cta-media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to right,
      rgb(31 78 74 / 0.94),
      rgb(31 78 74 / 0.88) 55%,
      rgb(31 78 74 / 0.78)
    );
  }

  .cta-inner {
    inline-size: min(100% - (var(--gutter) * 2), var(--width-page));
    margin-inline: auto;
  }


  .cta-heading {
    margin: 0;
    max-inline-size: var(--width-wide);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 600;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .cta-body {
    margin-block-start: var(--space-m);
    max-inline-size: var(--width-text);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  .cta-body :global(p) {
    margin: 0;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-l);
  }

  .cta-actions :global(a:not(.btn)) {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--rule-strong);
  }

  .cta-actions :global(a:not(.btn):hover) {
    text-decoration-color: var(--fg);
  }

  .cta-actions :global(a:not(.btn):focus-visible) {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
