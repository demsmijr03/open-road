---
import Logo from './Logo.astro';
import ComingSoon from './ComingSoon.astro';
---

<footer class="footer surface-deep">
  <div class="footer-inner">
    <div class="footer-brand">
      <Logo variant="full" />
      <p class="footer-mission">
        We fund West Chester Area School District students to attend the school that fits them best.
      </p>
    </div>

    <div class="footer-cols">
      <section class="footer-col">
        <h2>Contact</h2>
        <p>
          <a href="mailto:openroadfdn.admin@gmail.com">openroadfdn.admin@gmail.com</a>
        </p>
        <p class="footer-address">
          1427 Clover Lane<br />
          West Chester, PA 19380-5906
        </p>
      </section>

      <!-- One note rather than two. Instagram and LinkedIn are blocked on the
           same thing, so stacking a note under each made the column read as
           twice as unfinished as it is.

           `text` rather than the panel: "Follow" already labels the column, and
           the panel made the one missing item heavier than the address and the
           legal line beside it. -->
      <section class="footer-col">
        <h2>Follow</h2>
        <ComingSoon as="text" note="Instagram and LinkedIn, coming soon." />
      </section>

      <section class="footer-col footer-col--wide">
        <h2>Legal</h2>
        <p>
          The Open Road Foundation is a registered 501(c)(3) nonprofit organization. Donations are
          tax-deductible to the extent allowed by law.
        </p>
        <p class="footer-ein">
          EIN 42-3704788
        </p>
        <p><a href="/privacy/">Privacy</a></p>
      </section>
    </div>

    <!-- No Pennsylvania solicitation disclosure here, and that is a decision
         rather than an omission. The statement the Act prescribes begins "The
         official registration and financial information of ... may be obtained
         from the Pennsylvania Department of State", so printing it asserts a
         registration exists. Under the $25,000 threshold with no paid
         solicitors, the foundation is exempt and no registration is on file, so
         the statement would be untrue. If a BCO-10 is ever filed, whether by
         choice or on crossing the threshold, the statement becomes mandatory
         and belongs right here, verbatim, with the phone number. -->
    <div class="footer-base">
      <p>© 2026 The Open Road Foundation.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--pad-section);
  }

  .footer-inner {
    inline-size: min(100% - (var(--gutter) * 2), var(--width-page));
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* Same reason as .header-brand: no line box around the lockup, so the phantom
     descender space does not open a gap between the mark and the mission line
     under it. */
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-mission {
    margin: var(--space-s) 0 0;
    max-inline-size: 26rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-l);
    padding-block-start: var(--space-l);
    border-block-start: var(--border-hairline) solid var(--rule);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .footer-col--wide {
    grid-column: span 1;
  }

  .footer-col h2 {
    margin: 0 0 var(--space-2xs);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  .footer-col p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  /* ComingSoon renders its own <p>, which lives in that component's style
     scope, so the rule above never reaches it and the note would ship at body
     size in full-strength text. Reaching across the boundary explicitly, per
     CLAUDE.md, anchored to an element this component owns. */
  .footer-col :global(.soon-text) {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-quiet);
  }

  .footer-ein {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .footer-base {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-block-start: var(--space-l);
    border-block-start: var(--border-hairline) solid var(--rule);
    font-size: var(--text-sm);
    color: var(--fg-quiet);
  }

  .footer-base p {
    margin: 0;
  }

  .footer a {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--rule-strong);
  }

  .footer a:hover {
    text-decoration-color: var(--fg);
  }

  .footer a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
