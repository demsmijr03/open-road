---
/**
 * The site's one button.
 *
 * Fill and label come from the surface (see tokens.css), so a button never
 * picks its own colours and "apricot never sets text" stays true in one
 * place rather than in every component.
 *
 * Every clickable element carries hover, focus-visible and active states. See
 * CLAUDE.md; no exceptions. Only transform and opacity are animated.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit';
  class?: string;
  /**
   * Renders the real button, in its real place, with the word "placeholder"
   * on it and interaction disabled. The page gets its true shape while staying
   * honest that nothing is wired up yet, which is the same rule the rest of the
   * site follows: a hole stays visible rather than being quietly filled.
   */
  placeholder?: boolean;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
  placeholder = false,
} = Astro.props;

const Tag = placeholder ? 'button' : href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${variant}`, placeholder && 'btn--placeholder', className]}
  href={placeholder ? undefined : href}
  type={href && !placeholder ? undefined : type}
  disabled={placeholder ? true : undefined}
  aria-disabled={placeholder ? 'true' : undefined}
  data-placeholder={placeholder ? '' : undefined}
>
  <slot />
  {placeholder && <span class="btn-tag">placeholder</span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* 44px minimum touch target */
    min-block-size: 2.75rem;
    padding: 0.6rem 1.35rem;
    border-radius: var(--radius-btn);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    border: var(--border-hairline) solid transparent;
    transition:
      transform var(--duration) var(--ease-spring),
      opacity var(--duration) var(--ease-spring),
      background-color var(--duration) var(--ease-spring),
      border-color var(--duration) var(--ease-spring);
  }

  .btn--primary {
    background-color: var(--btn-fill);
    color: var(--btn-label);
  }

  .btn--primary:hover {
    background-color: var(--btn-fill-hover);
    transform: translateY(-1px);
  }

  .btn--secondary {
    background-color: transparent;
    color: var(--fg);
    border-color: var(--rule-strong);
  }

  .btn--secondary:hover {
    border-color: var(--fg);
    transform: translateY(-1px);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  /* Outlined rather than filled, so it reads as a slot waiting for a provider
     rather than as a live control. Never dimmed with opacity: that would drag
     the label under the contrast floor. */
  .btn--placeholder {
    background-color: transparent;
    color: var(--fg);
    border: var(--border-hairline) dashed var(--rule-strong);
    cursor: not-allowed;
  }

  .btn--placeholder:hover {
    transform: none;
    background-color: transparent;
  }

  .btn-tag {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-quiet);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover,
    .btn:active {
      transform: none;
    }
  }
</style>
