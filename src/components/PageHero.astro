---

/**
 * Interior page hero. Lighter than the home page's, one band of the deep surface at the
 * top, then the page opens onto paper. Keeps the dark surface to two
 * appearances per page (here and the closing band) so it stays meaningful.
 *
 * The optional `aside` slot carries a page's headline fact into the masthead,
 * so it is seen without scrolling. It renders only when filled, which leaves
 * every other page's hero exactly as it was.
 */
interface Props {
  heading: string;
  lede?: string;
}

const { heading, lede } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<!-- Load-in only, no scroll observer: this is the first thing on the page, so
     it is already on screen the moment the page paints. Pure CSS, per
     motion.css, so it runs with JavaScript off. -->
<section class="page-hero surface-deep">
  <div class:list={['wrap', hasAside && 'page-hero-grid']}>
    <div class="page-hero-copy rise" style="--rise-delay:60ms">
      <h1>{heading}</h1>
      {lede && <p class="page-hero-lede">{lede}</p>}
    </div>

    {
      hasAside && (
        <div class="page-hero-aside rise" style="--rise-delay:200ms">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--pad-section);
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--space-xl);
    /* End-aligned so the figure sits on the copy's baseline rather than
       floating in the middle of the band. */
    align-items: end;
  }


  .page-hero h1 {
    margin: 0;
    max-inline-size: var(--width-wide);
    font-size: clamp(2.25rem, 6vw, 3.75rem);
  }

  .page-hero-lede {
    margin: var(--space-m) 0 0;
    max-inline-size: var(--width-text);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--fg-quiet);
  }

  /* Stacked on narrow screens. The aside still lands high on the page, which is
     the whole point of putting it in the masthead. */
  @media (max-width: 60rem) {
    .page-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
    }

    .page-hero-aside {
      padding-block-start: var(--space-m);
      border-block-start: var(--border-hairline) solid var(--rule);
    }
  }
</style>
