---
import Logo from './Logo.astro';
import Button from './Button.astro';

interface Props {
  /**
   * Floats the header on top of the hero photograph instead of sitting above
   * it in a bar of its own. Home page only: interior pages have no full-bleed
   * image to float on.
   */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'Home' },
  { href: '/award/', label: 'For students' },
  { href: '/about/', label: 'About us' },
  { href: '/get-involved/', label: 'Get involved' },
];

const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class:list={['header', overlay ? 'header--overlay' : 'surface-base']}>
  <div class="header-inner">
    <a href="/" class="header-brand" aria-label="The Open Road Foundation, home">
      <Logo variant="full" />
    </a>

    <nav class="header-nav" aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Wrapped rather than styling the Button directly: a class passed to a
         child component lands on that child's root, which sits in the child's
         style scope, so Header's scoped `order` never reached it and the CTA
         fell back to order 0 and jumped above the logo. -->
    <div class="header-cta">
      <Button href="/get-involved/#interest" variant="secondary" class="header-ghost">Contact</Button>
      <Button href="/get-involved/#give">Support a student</Button>
    </div>
  </div>
</header>

<style>
  /* Floating over the hero photograph. The scrim on that image is what makes
     white text safe here, so this variant is only ever used on a page that has
     one: see index.astro. */
  .header--overlay {
    position: absolute;
    transition: background-color var(--duration) var(--ease-spring);
    /* Flush to the page edge, matching the full-bleed hero beneath it. The
       .header-inner already carries the gutter, so the bar's contents still
       line up with the hero copy. */
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 10;
    background: transparent;
    color: var(--color-surface);
    /* Every child reads these, so the whole bar flips with one declaration
       rather than each element opting in. */
    --fg: var(--color-surface);
    --fg-quiet: color-mix(in srgb, var(--color-surface) 82%, transparent);
    --rule: color-mix(in srgb, var(--color-surface) 26%, transparent);
    --rule-strong: color-mix(in srgb, var(--color-surface) 58%, transparent);
    --focus-ring: var(--color-surface);
    --btn-fill: var(--color-surface);
    --btn-label: var(--color-deep);
    --btn-fill-hover: var(--color-panel);
  }

  .header--overlay .header-inner {
    padding-block: var(--space-m);
  }

  .header {
    border-block-end: var(--border-hairline) solid var(--rule);
  }

  /* ---------------------------------------------------------------------
     STICKY AND CONDENSED

     Only from 62rem up, and that limit is the whole reason this is safe. Below
     it the bar wraps to two rows and stands about 110px tall; pinning that to
     the top of an 844px phone would spend an eighth of the viewport on
     navigation for the entire length of the page. On one row it costs a
     fraction of that.

     What animates is background-color and border-color, both paint-only. The
     padding change is deliberately NOT transitioned: padding is a layout
     property, and animating it would relayout the bar every frame against the
     house rule that only transform and opacity are animated. The step is small
     enough that it reads as the bar settling under the colour fade rather than
     as a jump.
     --------------------------------------------------------------------- */
  @media (min-width: 62rem) {
    .header:not(.header--overlay) {
      position: sticky;
      inset-block-start: 0;
      z-index: 10;
      transition:
        background-color var(--duration) var(--ease-spring),
        border-color var(--duration) var(--ease-spring);
    }

    /* Fixed rather than absolute, so it stays put once the hero scrolls away.
       At rest it is still transparent over the photograph, so the page looks
       exactly as it did. */
    .header--overlay {
      position: fixed;
    }

    .header.is-condensed .header-inner,
    .header--overlay.is-condensed .header-inner {
      padding-block: var(--space-2xs);
    }

    /* The overlay bar has no ground of its own. Once it is off the hero it
       needs one, or white labels sit on whatever content happens to pass
       underneath. */
    .header--overlay.is-condensed {
      background-color: var(--color-deep);
      border-block-end-color: var(--rule);
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    inline-size: min(100% - (var(--gutter) * 2), var(--width-page));
    margin-inline: auto;
    padding-block: var(--space-s);
  }

  .header-brand {
    color: var(--fg);
    text-decoration: none;
    border-radius: var(--radius-btn);
  }

  .header-brand:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 4px;
  }

  .header-nav {
    margin-inline-start: auto;
  }

  .header-cta {
    display: flex;
    gap: var(--space-2xs);
  }

  /* Pills in the bar, per the reference. The rest of the site keeps the
     squarer button, so this stays a header decision rather than a global one. */
  .header-cta :global(.btn) {
    border-radius: 999px;
    padding-inline: 1.15rem;
  }

  @media (max-width: 30rem) {
    .header-ghost {
      display: none;
    }
  }

  .header-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header-nav a {
    display: inline-block;
    /* 44px target without pushing the bar taller */
    padding-block: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    position: relative;
  }

  /* A solid underline as the active indicator. */
  .header-nav a[aria-current='page']::after,
  .header-nav a:hover::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.35rem;
    block-size: 2px;
    border-radius: 2px;
    background-color: var(--fg);
  }

  .header-nav a:hover::after {
    opacity: 0.5;
  }

  .header-nav a[aria-current='page']::after {
    opacity: 1;
  }

  .header-nav a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: var(--radius-btn);
  }

  /* Narrow screens: the brand takes the first row on its own, and the nav and
     the CTA share the second, with the CTA at the right end.

     The earlier rule moved only the nav to row two and left the CTA sitting
     beside the logo, which put the button before the links it should follow.
     Ordering both explicitly keeps "Support a student" to the right of the four
     tabs at every width.

     No hamburger: four links fit, and a disclosure widget for four items is
     more machinery than the content needs. */
  @media (max-width: 62rem) {
    .header-inner {
      flex-wrap: wrap;
      gap: var(--space-xs) var(--space-m);
    }

    .header-brand {
      order: 1;
      inline-size: 100%;
    }

    .header-nav {
      order: 2;
      margin-inline-start: 0;
    }

    .header-nav ul {
      gap: var(--space-m);
      flex-wrap: wrap;
    }

    .header-cta {
      order: 3;
      margin-inline-start: auto;
    }
  }

  @media (max-width: 26rem) {
    .header-nav ul {
      gap: var(--space-xs);
    }

    .header-nav a {
      font-size: var(--text-xs);
    }
  }
</style>
